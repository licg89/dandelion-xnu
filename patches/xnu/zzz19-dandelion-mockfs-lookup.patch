+#if defined(DANDELION)
+/* mockfs lookup markers - see docs/NEXT-SESSION.md 0.-10. */
+extern void dandelion_trace_mark(const char *);
+extern int snprintf(char *, size_t, const char *, ...);
+
+static void
+dl_mockfs_mark(const char *what, const char *name, int a, int b)
+{
+	char _buf[144];
+
+	snprintf(_buf, sizeof(_buf), "[dl] mockfs %s %s a=%d b=%d\n", what,
+	    name ? name : "-", a, b);
+	dandelion_trace_mark(_buf);
+}
+#define DL_MOCK(what, name, a, b)  dl_mockfs_mark((what), (name), (a), (b))
+#else
+#define DL_MOCK(what, name, a, b)  do { } while (0)
+#endif
