+/*
+ * Route the shared GIC bring-up steps into the console (and therefore into the
+ * eMMC log channel).  dandelion_gic.h defaults this to a no-op because the boot
+ * shim has no console; here we want every step, because one of the ICC_*
+ * accesses stops this machine dead with no output at all.
+ */
+#define DGIC_TRACE(step)  kprintf("%s\n", step)
+#include <pexpert/arm64/dandelion_gic.h>
+
+/*
+ * The late timer bring-up below reports through printf(), not kprintf():
+ * kprintf() is compiled out on this build (disable_serial_output is set
+ * because the debug= boot argument does not carry DB_KPRT), while printf()
+ * still reaches the panel and the eMMC log.
+ */
+
+
+/* Exported for the late-boot diagnostics in IOPlatformExpert.cpp. */
+uint32_t dandelion_gic_arch_rev;
+uint32_t dandelion_gic_pidr2;
+uint32_t dandelion_gic_typer;
+uint64_t dandelion_gicr_typer_v;
+uint32_t dandelion_gic_ctlr_pre;
+uint32_t dandelion_gic_ctlr_post;
+uint32_t dandelion_gic_igroupr_pre;
+uint32_t dandelion_gic_igroupr_post;
+
+#if HAS_GIC_V3
+
+static struct dgic dandelion_gic;
+static int dandelion_gic_ready;
+static int dandelion_gic_group0;
+
+int
+dandelion_gic_uses_group0(void)
+{
+	return dandelion_gic_group0;
+}
+
+uint32_t
+dandelion_gic_ack(void)
+{
+	if (!dandelion_gic_ready) {
+		return DGIC_INTID_SPURIOUS;
+	}
+	return dgic_ack(&dandelion_gic);
+}
+
+void
+dandelion_gic_eoi(uint32_t intid)
+{
+	if (!dandelion_gic_ready) {
+		return;
+	}
+	dgic_eoi(&dandelion_gic, intid);
+}
