 		    (unsigned long long)_hppir1, (unsigned long long)_rpr);
 
-		dandelion_trace_mark("[dl] timerprobe: before IOSleep(200)\n");
-		IOSleep(200);
-		dandelion_trace_mark("[dl] timerprobe: after IOSleep(200)\n");
+		dandelion_trace_mark("[dl] timerprobe: before busy-wait(200ms)\n");
+		/*
+		 * Busy-wait, not IOSleep().  IOSleep() parks the thread on a timed
+		 * wait, and with no timer interrupt that wait can never expire --
+		 * measured: the "after" line never printed and bsd_init stopped
+		 * here forever.  The counter counts regardless of interrupts, so
+		 * spinning on CNTPCT measures the same 200 ms and always returns.
+		 * The cap is only there so a dead counter cannot hang the boot
+		 * again; it is not expected to be reached.
+		 */
+		{
+			uint64_t _freq = __builtin_arm_rsr64("CNTFRQ_EL0");
+			uint64_t _pstart = __builtin_arm_rsr64("CNTPCT_EL0");
+			uint64_t _vstart = __builtin_arm_rsr64("CNTVCT_EL0");
+			uint64_t _elapsed = 0, _ticks;
+			unsigned long _spins = 0;
+
+			if (_freq == 0) {
+				_freq = 13000000ull;
+			}
+			_ticks = (_freq / 1000ull) * 200ull;
+			while (_spins < 500000000ul) {
+				_elapsed = __builtin_arm_rsr64("CNTPCT_EL0") - _pstart;
+				if (_elapsed >= _ticks) {
+					break;
+				}
+				_spins++;
+			}
+			/*
+			 * The two raw counters are printed side by side: their
+			 * difference is CNTVOFF.  If it is not 0, the virtual
+			 * counter the timebase reads and the physical counter the
+			 * timer compares are offset, which matters for every
+			 * deadline the kernel computes.
+			 */
+			printf("[dl] timerprobe: busy-wait spans=%lu elapsed=%llu "
+			    "ticks=%llu freq=%llu cntpct=%llx cntvct=%llx\n", _spins,
+			    (unsigned long long)_elapsed, (unsigned long long)_ticks,
+			    (unsigned long long)_freq,
+			    (unsigned long long)_pstart,
+			    (unsigned long long)_vstart);
+		}
+		dandelion_trace_mark("[dl] timerprobe: after busy-wait(200ms)\n");
 	}
 #endif
 	while (TRUE) {
