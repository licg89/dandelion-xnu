+		__builtin_arm_isb(ISB_SY);
+		printf("[dl] gic late: sgi self-test ispender0 %x -> %x "
+		    "(bit9=%u spin=%u mpidr=%llx)\n", before, after,
+		    (after & (1u << 9)) ? 1u : 0u, spin,
+		    (unsigned long long)mpidr);
 	}
