+		dgic_write32(gicd, DGICD_CTLR,
+		    before | DGICD_CTLR_ENABLE0 | DGICD_CTLR_ENABLE1);
+		for (spin = 0; spin < 1000000u; spin++) {
+			after = dgic_read32(gicd, DGICD_CTLR);
+			if ((after & DGICD_CTLR_RWP) == 0) {
+				break;
+			}
+		}
+		printf("[dl] gic late: ctlr rwp-waited %x -> %x (spin=%u rwp=%u)\n",
+		    before, after, spin, (after & DGICD_CTLR_RWP) ? 1u : 0u);
