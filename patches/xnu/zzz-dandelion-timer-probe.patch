 		printf("[dl] IOFindBSDRoot: wait timed out after 30 s\n");
-#endif
 	}
+#endif
 	matching->release();
 	matching = NULL;
 
 	if (mountAttempts++) {
 		IOLog("mount(%d) failed\n", mountAttempts);
+#if !defined(DANDELION)
