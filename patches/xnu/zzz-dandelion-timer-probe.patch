diff --git a/bsd/kern/bsd_init.c b/bsd/kern/bsd_init.c
index ffa214d..ed20eee 100644
--- a/bsd/kern/bsd_init.c
+++ b/bsd/kern/bsd_init.c
@@ -920,9 +920,49 @@ bsd_init(void)
 		printf("[dl] regs hppir1=%llx(1023=spurious) rpr=%llx\n",
 		    (unsigned long long)_hppir1, (unsigned long long)_rpr);
 
-		dandelion_trace_mark("[dl] timerprobe: before IOSleep(200)\n");
-		IOSleep(200);
-		dandelion_trace_mark("[dl] timerprobe: after IOSleep(200)\n");
+		dandelion_trace_mark("[dl] timerprobe: before busy-wait(200ms)\n");
+		/*
+		 * Busy-wait, not IOSleep().  IOSleep() parks the thread on a timed
+		 * wait, and with no timer interrupt that wait can never expire --
+		 * measured: the "after" line never printed and bsd_init stopped
+		 * here forever.  The counter counts regardless of interrupts, so
+		 * spinning on CNTPCT measures the same 200 ms and always returns.
+		 * The cap is only there so a dead counter cannot hang the boot
+		 * again; it is not expected to be reached.
+		 */
+		{
+			uint64_t _freq = __builtin_arm_rsr64("CNTFRQ_EL0");
+			uint64_t _pstart = __builtin_arm_rsr64("CNTPCT_EL0");
+			uint64_t _vstart = __builtin_arm_rsr64("CNTVCT_EL0");
+			uint64_t _elapsed = 0, _ticks;
+			unsigned long _spins = 0;
+
+			if (_freq == 0) {
+				_freq = 13000000ull;
+			}
+			_ticks = (_freq / 1000ull) * 200ull;
+			while (_spins < 500000000ul) {
+				_elapsed = __builtin_arm_rsr64("CNTPCT_EL0") - _pstart;
+				if (_elapsed >= _ticks) {
+					break;
+				}
+				_spins++;
+			}
+			/*
+			 * The two raw counters are printed side by side: their
+			 * difference is CNTVOFF.  If it is not 0, the virtual
+			 * counter the timebase reads and the physical counter the
+			 * timer compares are offset, which matters for every
+			 * deadline the kernel computes.
+			 */
+			printf("[dl] timerprobe: busy-wait spans=%lu elapsed=%llu "
+			    "ticks=%llu freq=%llu cntpct=%llx cntvct=%llx\n", _spins,
+			    (unsigned long long)_elapsed, (unsigned long long)_ticks,
+			    (unsigned long long)_freq,
+			    (unsigned long long)_pstart,
+			    (unsigned long long)_vstart);
+		}
+		dandelion_trace_mark("[dl] timerprobe: after busy-wait(200ms)\n");
 	}
 #endif
 	while (TRUE) {
diff --git a/iokit/bsddev/IOKitBSDInit.cpp b/iokit/bsddev/IOKitBSDInit.cpp
index aeedc7d..01ccbf4 100644
--- a/iokit/bsddev/IOKitBSDInit.cpp
+++ b/iokit/bsddev/IOKitBSDInit.cpp
@@ -684,25 +684,60 @@ IOFindBSDRoot( char * rootName, unsigned int rootNameSize,
 	matching->setObject(gIOResourceMatchedKey, gIOBSDKey);
 
 #if defined(DANDELION)
+	/*
+	 * Bring-up: this port has no timer interrupt yet (see pexpert/arm/pe_fiq.c),
+	 * so the 30 s timed wait cannot expire -- a thread blocked on a deadline
+	 * needs a tick to wake it, and there is none.  Poll the registry for a
+	 * bounded span of counter ticks instead, and report which way it went, so
+	 * the boot keeps moving and the log says whether an IOBSD resource exists
+	 * at all.
+	 */
+	{
+		uint64_t _freq = __builtin_arm_rsr64("CNTFRQ_EL0");
+		uint64_t _start = __builtin_arm_rsr64("CNTPCT_EL0");
+		uint64_t _limit;
+		unsigned int _polls = 0;
+
+		if (_freq == 0) {
+			_freq = 13000000ull;
+		}
+		_limit = (_freq / 1000ull) * 200ull;   /* 200 ms, not 30 s */
+		service = NULL;
+		for (_polls = 0; _polls < 1000000u; _polls++) {
+			service = IOService::copyMatchingService(matching);
+			if (service) {
+				break;
+			}
+			if ((__builtin_arm_rsr64("CNTPCT_EL0") - _start) >= _limit) {
+				break;
+			}
+		}
+		printf("[dl] IOFindBSDRoot: IOBSD resource %s (polls=%u)\n",
+		    service ? "matched" : "absent after 200 ms", _polls);
+		if (service) {
+			service->release();
+			service = NULL;
+		}
+	}
+#else
 	printf("[dl] IOFindBSDRoot: waiting for the IOBSD resource (30 s)\n");
-#endif
 	if ((service = IOService::waitForMatchingService(matching, 30ULL * kSecondScale))) {
 		OSSafeReleaseNULL(service);
-#if defined(DANDELION)
 		printf("[dl] IOFindBSDRoot: resource matched\n");
-#endif
 	} else {
 		IOLog("!BSD\n");
-#if defined(DANDELION)
 		printf("[dl] IOFindBSDRoot: wait timed out after 30 s\n");
-#endif
 	}
+#endif
 	matching->release();
 	matching = NULL;
 
 	if (mountAttempts++) {
 		IOLog("mount(%d) failed\n", mountAttempts);
+#if !defined(DANDELION)
+		/* Under DANDELION this would block forever: no tick to expire it. */
 		IOSleep( 5 * 1000 );
+#endif
 	}
 
 	str = OSDataAllocation<char>( kMaxPathBuf + kMaxBootVar, OSAllocateMemory );
