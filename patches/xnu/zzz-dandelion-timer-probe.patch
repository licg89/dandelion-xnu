+void
+pe_init_fiq(void)
+{
+	int error;
+
+	/*
+	 * One-time CPU interface setup for this PE.  No MMIO: see the file
+	 * comment.  The shim has already done the distributor/redistributor
+	 * work, including enabling the timer PPI on the boot CPU.
+	 */
+	if (!dandelion_gic_ready) {
+		dandelion_gic.mode = DGIC_MODE_V3;
+		dandelion_gic.group = DGIC_GROUP1;      /* SecurityExtn == 1 */
+		dandelion_gic.redist = 0;
+		dandelion_gic.gicc = 0;
+
+		kprintf("DANDELION: cpu interface init ...\n");
+		error = dgic_cpuif_init(&dandelion_gic);
+		kprintf("DANDELION: cpu interface init returned %d\n", error);
+		if (error != DGIC_OK) {
+			kprintf("DANDELION: cpu interface init failed (%d)\n",
+			    error);
+			return;
+		}
+
+		dandelion_gic_group0 = 0;
+		dandelion_gic_ready = 1;
+		dandelion_gic_arch_rev = 3;
+
+		/*
+		 * Give the decrementer a real deadline.  arm_init() enables CNTV
+		 * (fiq_context_init) without ever writing TVAL, so the very first
+		 * tick is an already-expired interrupt - the interrupt arrives
+		 * before any handler is ready for it.  10 ms is the usual tick.
+		 */
+		{
+			uint64_t freq = __builtin_arm_rsr64("CNTFRQ_EL0");
+
+			if (freq == 0) {
+				freq = 13000000;
+			}
+			__builtin_arm_wsr64("CNTP_TVAL_EL0", freq / 100);
+			__builtin_arm_wsr64("CNTP_CTL_EL0", 1);
+		}
+
+		kprintf("DANDELION: icc ready (sre=%lx pmr=%lx ctlr=%lx), "
+		    "timer INTID %u on Group1/IRQ\n",
+		    dandelion_gic.icc_sre_el1, dandelion_gic.icc_pmr,
+		    dandelion_gic.icc_ctlr, DANDELION_TIMER_IRQ);
+		return;
+	}
+
+	/* Secondary CPU: its own CPU interface, nothing shared. */
+	error = dgic_cpuif_init(&dandelion_gic);
+	if (error != DGIC_OK) {
+		kprintf("DANDELION: cpu%u cpu interface init failed (%d)\n",
+		    ml_get_cpu_number_local(), error);
+		return;
+	}
+	kprintf("DANDELION: cpu%u icc up\n", ml_get_cpu_number_local());
+}
+
+/*
+ * Late timer-PPI bring-up.
+ *
+ * Measured state this kernel boots with (IMG_5812):
+ *
+ *   DAIF        = 0x200   IRQs enabled
+ *   CNTV_CTL    = 0x5     ENABLE=1, IMASK=0, ISTATUS=1 (expired, asserting)
+ *   ICC_SRE/PMR/IGRPEN1   CPU interface open for Group 1
+ *   ICC_HPPIR1  = 0x3ff   nothing pending
+ *
+ * So the decrementer is firing and the CPU interface would accept the
+ * interrupt, but the redistributor never forwards the timer PPI: no tick
+ * ever arrives, every deadline sleep blocks forever (that is why
+ * bsd_init's 200 ms IOSleep never returns), and nothing time based works.
+ *
+ * Fix: program this PE's redistributor only.  GICD_CTLR and GICD_IGROUPR
+ * belong to EL3 on this SoC and writing them from non-secure kernel context
+ * stalls the bus (see the file comment), so the distributor is only read and
+ * its group-enable state reported.  The redistributor's group register
+ * (GICR_IGROUPR0) is per-PE and is safe to write.
+ */
+int
+dandelion_gic_late_init(void)
+{
+	/* /interrupt-controller@0c000000 in the device tree: GICD then GICR. */
+#define DANDELION_GICD_PA   0x0c000000UL
+#define DANDELION_GICD_SIZE 0x00040000UL
+#define DANDELION_GICR_PA   0x0c100000UL
+#define DANDELION_GICR_SIZE 0x00200000UL
+
+	unsigned long gicd, gicr, redist;
+	uint32_t waker, group, icfgr, isen;
+	int error;
+
+	/* Device memory only: the physmap is cacheable and must not carry MMIO. */
+	gicd = ml_io_map(DANDELION_GICD_PA, DANDELION_GICD_SIZE);
+	gicr = ml_io_map(DANDELION_GICR_PA, DANDELION_GICR_SIZE);
+	if (gicd == 0 || gicr == 0) {
+		printf("[dl] gic late: ml_io_map failed (gicd=%lx gicr=%lx)\n",
+		    gicd, gicr);
+		return -1;
+	}
+
+	dandelion_gic.gicd = gicd;
+	dandelion_gic.gicd_size = DANDELION_GICD_SIZE;
+	dandelion_gic.gicr = gicr;
+	dandelion_gic.gicr_size = DANDELION_GICR_SIZE;
+	dandelion_gic.mode = DGIC_MODE_V3;
+	dandelion_gic.group = DGIC_GROUP1;
+	dandelion_gic.gicc = 0;
+
+	printf("[dl] gic late: gicd typer=%x ctlr=%x (bit0=EnableGrp1NS)\n",
+	    dgic_read32(gicd, DGICD_TYPER), dgic_read32(gicd, DGICD_CTLR));
+
+	redist = dgic_find_redist(&dandelion_gic);
+	if (redist == 0) {
+		printf("[dl] gic late: no redistributor for this PE\n");
+		return -2;
+	}
+	dandelion_gic.redist = redist;
+
+	waker = dgic_read32(redist, DGICR_WAKER);
+	printf("[dl] gic late: redist=%lx typer=%llx waker=%x\n", redist,
+	    (unsigned long long)dgic_read64(redist, DGICR_TYPER), waker);
+
+	/* 1. Wake this PE's redistributor if the firmware left it asleep. */
+	if (waker & DGICR_WAKER_CHILDRENASLEEP) {
+		dgic_write32(redist, DGICR_WAKER,
+		    waker & ~DGICR_WAKER_PROCESSORSLEEP);
+		for (unsigned int spin = 0; spin < 2000000u; spin++) {
+			if ((dgic_read32(redist, DGICR_WAKER) &
+			    DGICR_WAKER_CHILDRENASLEEP) == 0) {
+				break;
+			}
+		}
+		if (dgic_read32(redist, DGICR_WAKER) &
+		    DGICR_WAKER_CHILDRENASLEEP) {
+			printf("[dl] gic late: redistributor stayed asleep\n");
+			return -3;
+		}
+		printf("[dl] gic late: redistributor woken\n");
+	}
+
+	/* 2. Timer PPI -> Group 1, priority 0xa0, level sensitive. */
+	group = dgic_read32(redist, DGICR_IGROUPR0);
+	printf("[dl] gic late: igroupr0=%x (bit%u)\n", group, DANDELION_TIMER_IRQ);
+	dgic_write32(redist, DGICR_IGROUPR0, group | (1u << DANDELION_TIMER_IRQ));
+
+	dgic_set_priority32(redist, DGICR_IPRIORITYR, DANDELION_TIMER_IRQ,
+	    DGIC_PRIORITY_DEFAULT);
+
+	icfgr = dgic_read32(redist, DGICR_ICFGR1);
+	icfgr &= ~(0x3u << (((DANDELION_TIMER_IRQ - 16u) % 16u) * 2u));
+	icfgr |= (0x2u << (((DANDELION_TIMER_IRQ - 16u) % 16u) * 2u));  /* level */
+	dgic_write32(redist, DGICR_ICFGR1, icfgr);
+
+	/* 3. Enable it, then read the state back. */
+	dgic_write32(redist, DGICR_ISENABLER0, 1u << DANDELION_TIMER_IRQ);
+	isen = dgic_read32(redist, DGICR_ISENABLER0);
+	printf("[dl] gic late: isenabler0=%x igroupr0=%x icfgr1=%x\n", isen,
+	    dgic_read32(redist, DGICR_IGROUPR0), dgic_read32(redist, DGICR_ICFGR1));
+	/*
+	 * The group question has to be asked in registers non-secure may read.
+	 *
+	 * A first attempt read ICC_HPPIR0_EL1 and ICC_IGRPEN0_EL1 and the kernel
+	 * died on the spot: with GICD_CTLR.DS == 0, the Group 0 system registers are
+	 * undefined from EL1 non-secure, because Group 0 belongs to EL3.  The log
+	 * ended mid-probe, which is how this was found.
+	 *
+	 * So ask it here instead:
+	 *   GICR_ISPENDR0  Group 1 NS pending for this PE.  The timer is armed and
+	 *                  PPI 27 is enabled, so if this reads 0 the interrupt is
+	 *                  simply not a Group 1 interrupt.
+	 *   GICR_IACTIVER0 Group 1 NS active.
+	 *   ICC_IGRPEN1    the Group 1 NS enable at the CPU interface (legal to read).
+	 */
+	printf("[dl] gic late: ispender0=%x iactiver0=%x igrpen1=%llx\n",
+	    dgic_read32(redist, 0x200), dgic_read32(redist, 0x300),
+	    (unsigned long long)__builtin_arm_rsr64("ICC_IGRPEN1_EL1"));
+
+	printf("[dl] gic late: hppir1=%llx\n",
+	    (unsigned long long)__builtin_arm_rsr64("ICC_HPPIR1_EL1"));
+
+	/*
+	 * Experiment A: is EnableGrp1NS writable from EL1 non-secure, or was the
+	 * earlier "10 -> 10" a read taken while the write was still in flight?
+	 *
+	 * GICD_CTLR.RWP (bit 31) is the architectural answer to exactly that
+	 * question: the distributor sets it while a write to the register is
+	 * still being committed, and software must poll it until it clears
+	 * before it may believe a read-back.  The probe that produced "10 -> 10"
+	 * read back immediately, so a refused write and a stale read were never
+	 * told apart.  This waits it out, and reports how many polls it took.
+	 */
+	{
+		uint32_t before = dgic_read32(gicd, DGICD_CTLR);
+		uint32_t after = before;
+		unsigned int spin = 0;
+
+		dgic_write32(gicd, DGICD_CTLR,
+		    before | DGICD_CTLR_ENABLE0 | DGICD_CTLR_ENABLE1);
+		for (spin = 0; spin < 1000000u; spin++) {
+			after = dgic_read32(gicd, DGICD_CTLR);
+			if ((after & DGICD_CTLR_RWP) == 0) {
+				break;
+			}
+		}
+		printf("[dl] gic late: ctlr rwp-waited %x -> %x (spin=%u rwp=%u)\n",
+		    before, after, spin, (after & DGICD_CTLR_RWP) ? 1u : 0u);
+	}
+
+	/*
+	 * Experiment B: arm CNTP for one tick and watch for the PPI, with no
+	 * kernel interrupt path involved.  dgic_timer_test() polls the counter
+	 * itself and acknowledges through ICC_IAR1, so it cannot block and it
+	 * leaves nothing active behind.  Its return value separates three worlds:
+	 *
+	 *   bit0 set            the CPU interface handed over INTID 30: the tick
+	 *                       works and everything downstream is unblocked
+	 *   bit1 set, bit0 clear the timer expired but nothing reached the CPU
+	 *                       interface: the interrupt is swallowed between the
+	 *                       timer and ICC_HPPIR1
+	 *   neither             the timer did not even expire
+	 */
+	{
+		unsigned long freq = __builtin_arm_rsr64("CNTFRQ_EL0");
+		uint32_t pend_before = dgic_read32(redist, DGICR_ISPENDR0);
+		int result = dgic_timer_test(&dandelion_gic, DANDELION_TIMER_IRQ,
+		    20000u);
+		uint32_t pend_after = dgic_read32(redist, DGICR_ISPENDR0);
+
+		printf("[dl] gic late: cntp test=%d (1=delivered 2=expired 3=both) "
+		    "ispender0 %x -> %x freq=%lu\n", result, pend_before,
+		    pend_after, freq);
+		/* dgic_timer_test() masks CNTP again; leave it armed for the kernel. */
+		__builtin_arm_wsr64("CNTP_TVAL_EL0", freq / 100u);
+		__builtin_arm_wsr64("CNTP_CTL_EL0", 1ul);
+		dgic_isb();
+	}
+
+	/*
+	 * Experiment C: does the Group 1 NS path work at all?
+	 *
+	 * Sending a software generated interrupt to this PE asks the question
+	 * without the timer: an SGI is not gated by GICR_ICFGR, does not depend
+	 * on the counter, and its INTID is known.  ICC_IGRPEN1 is cleared first
+	 * so that a pending interrupt can never be delivered to the CPU during
+	 * the test (an unexpected IRQ at this point would run the kernel's
+	 * handler with a stack that is not expecting it); the pending bit is
+	 * still observable, because pending state does not depend on the group
+	 * enable.  Everything is restored afterwards.
+	 *
+	 *   ISPENDR0 bit9 set  the redistributor frame is this PE's and Group 1
+	 *                      NS interrupts can be pended -> the timer problem
+	 *                      is the PPI line, not the group enable
+	 *   bit9 still clear   nothing of Group 1 NS can be made pending here
+	 */
+	{
+		uint64_t mpidr = __builtin_arm_rsr64("MPIDR_EL1");
+		unsigned int aff0 = (unsigned int)(mpidr & 0xffull);
+		unsigned int aff1 = (unsigned int)((mpidr >> 8) & 0xffull);
+		uint32_t before = dgic_read32(redist, DGICR_ISPENDR0);
+		uint32_t after = 0;
+		unsigned int spin;
+
+		__builtin_arm_wsr64("ICC_IGRPEN1_EL1", 0ul);
+		dgic_isb();
+		dgic_send_sgi(&dandelion_gic, 9u, aff1, 1u << aff0);
+		for (spin = 0; spin < 100000u; spin++) {
+			after = dgic_read32(redist, DGICR_ISPENDR0);
+			if (after & (1u << 9)) {
+				break;
+			}
+		}
+		dgic_write32(redist, DGICR_ICPENDR0, 1u << 9);
+		__builtin_arm_wsr64("ICC_IGRPEN1_EL1", 1ul);
+		dgic_isb();
+		printf("[dl] gic late: sgi self-test ispender0 %x -> %x "
+		    "(bit9=%u spin=%u mpidr=%llx)\n", before, after,
+		    (after & (1u << 9)) ? 1u : 0u, spin,
+		    (unsigned long long)mpidr);
+	}
+
+	/* 4. Make sure the CPU interface and the ack/eoi helpers are usable. */
+	if (!dandelion_gic_ready) {
+		error = dgic_cpuif_init(&dandelion_gic);
+		if (error != DGIC_OK) {
+			printf("[dl] gic late: cpuif init failed (%d)\n", error);
+			return -4;
+		}
+		dandelion_gic_ready = 1;
+	}
+	printf("[dl] gic late: done, timer INTID %u enabled\n", DANDELION_TIMER_IRQ);
+	return 0;
+}
+#else
+void
+pe_init_fiq(void)
+{
+}
+
+int
+dandelion_gic_uses_group0(void)
+{
+	return 0;
+}
+
+uint32_t
+dandelion_gic_ack(void)
+{
+	return DGIC_INTID_SPURIOUS;
+}
+
+void
+dandelion_gic_eoi(uint32_t intid)
+{
+	(void)intid;
+}
+
+int
+dandelion_gic_late_init(void)
+{
+	return -1;
+}
+#endif /* HAS_GIC_V3 */
