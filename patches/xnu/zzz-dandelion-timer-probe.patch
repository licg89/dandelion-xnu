+	/*
+	 * Experiment B: arm CNTP for one tick and watch for the PPI, with no
+	 * kernel interrupt path involved.  dgic_timer_test() polls the counter
+	 * itself and acknowledges through ICC_IAR1, so it cannot block and it
+	 * leaves nothing active behind.  Its return value separates three worlds:
+	 *
+	 *   bit0 set            the CPU interface handed over INTID 30: the tick
+	 *                       works and everything downstream is unblocked
+	 *   bit1 set, bit0 clear the timer expired but nothing reached the CPU
+	 *                       interface: the interrupt is swallowed between the
+	 *                       timer and ICC_HPPIR1
+	 *   neither             the timer did not even expire
+	 */
+	{
+		unsigned long freq = __builtin_arm_rsr64("CNTFRQ_EL0");
+		uint32_t pend_before = dgic_read32(redist, DGICR_ISPENDR0);
+		int result = dgic_timer_test(&dandelion_gic, DANDELION_TIMER_IRQ,
+		    20000u);
+		uint32_t pend_after = dgic_read32(redist, DGICR_ISPENDR0);
