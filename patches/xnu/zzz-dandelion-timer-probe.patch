+ *
+ * Dandelion (Xiaomi Redmi 9A / MediaTek MT6762G) interrupt controller glue.
+ *
+ * Division of labour, decided by measurement on the device:
+ *
+ *   boot shim (MMU off)
+ *       Programs the distributor and this PE's redistributor through
+ *       pexpert/pexpert/arm64/dandelion_gic.h, with the MMU off.  Every access
+ *       there either takes effect or is silently dropped by the security
+ *       fabric, and the machine survives either way.
+ *
+ *   kernel (MMU on)
+ *       Programs only the system-register CPU interface (ICC_*), which is
+ *       per-CPU state and does not go through the interconnect.
+ *
+ * Why the kernel must not touch the distributor: doing so stalled the bus and
+ * the boot stopped right after 'arm_init: cpu_timabase_init', a dozen lines
+ * earlier than with the untouched GIC.  On this SoC the GIC implements both
+ * security states, so most distributor state belongs to EL3 in the first
+ * place - Linux receives its arch timer interrupt because the secure firmware
+ * has already arranged the groups, not because Linux set them up.
+ *
+ * Everything the kernel needs from the hardware - mode (GICv3), group
+ * (Group 1 / IRQ, because GICD_TYPER.SecurityExtn == 1) and the timer INTID -
+ * was measured with the shim's GIC inventory and is reported there.
+ */
+
+#include <stdint.h>
+#include <arm64/proc_reg.h>
+#include <kern/clock.h>
+#include <machine/machine_routines.h>
+#include <pexpert/device_tree.h>
+#include <pexpert/pexpert.h>
+#include <pexpert/arm64/board_config.h>
