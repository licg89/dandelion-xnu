diff --git a/pexpert/arm/pe_init.c b/pexpert/arm/pe_init.c
index 04dda53..c3e704c 100644
--- a/pexpert/arm/pe_init.c
+++ b/pexpert/arm/pe_init.c
@@ -514,6 +514,16 @@ PE_create_console(void)
 
 	if (PE_state.video.v_display) {
 		PE_initialize_console(&PE_state.video, kPEGraphicsMode);
+#if defined(DANDELION)
+		/*
+		 * This port has no serial console and no boot progress meter, so
+		 * the only way to see kernel output is the framebuffer text
+		 * console.  Ask for it explicitly; without this the console stays
+		 * in graphics mode and disableConsoleOutput suppresses every
+		 * kprintf().
+		 */
+		initialize_screen(NULL, kPETextScreen);
+#endif /* DANDELION */
 	} else {
 		PE_initialize_console(&PE_state.video, kPETextMode);
 	}
