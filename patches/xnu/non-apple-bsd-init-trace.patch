diff --git a/bsd/kern/bsd_init.c b/bsd/kern/bsd_init.c
index 4df41ba..90f74b5 100644
--- a/bsd/kern/bsd_init.c
+++ b/bsd/kern/bsd_init.c
@@ -490,10 +490,24 @@ bsd_init(void)
 	platform_stall_panic_or_spin(PLATFORM_STALL_XNU_LOCATION_BSD_INIT);
 #endif
 
+#if defined(DANDELION)
+/*
+ * Bring-up: bsd_init() has no other way to report progress on a machine
+ * with neither a serial console nor a debugger, so keep the trace.
+ */
+#define DEBUG_BSDINIT 1
+#else
 #define DEBUG_BSDINIT 0
+#endif
 
 #if DEBUG_BSDINIT
-#define bsd_init_kprintf(x, ...) kprintf("bsd_init: " x, ## __VA_ARGS__)
+/*
+ * Use printf(), not kprintf(): this kernel runs with
+ * disable_serial_output/disable_kprintf_output set (debug= boot-arg lacks
+ * DB_KPRT and this is a DEVELOPMENT build), so kprintf() is silently
+ * dropped, while printf() still reaches the console and the eMMC log.
+ */
+#define bsd_init_kprintf(x, ...) printf("bsd_init: " x, ## __VA_ARGS__)
 #else
 #define bsd_init_kprintf(x, ...)
 #endif
@@ -857,6 +871,53 @@ bsd_init(void)
 	inittodr(0);
 
 	/* Mount the root file system. */
+#if defined(DANDELION)
+	{
+		extern void dandelion_trace_mark(const char *);
+		dandelion_trace_mark("[dl] root mount: entering loop\n");
+	}
+	/*
+	 * Bring-up probe: setconf() below calls IOFindBSDRoot(), which waits on
+	 * a 30 s deadline for the IOBSD resource.  A 200 ms IOSleep() is the
+	 * cheapest test of whether timer interrupts are delivered at all: if
+	 * "after" never prints, no deadline can ever expire and the 30 s wait
+	 * hangs forever.
+	 *
+	 * The read-only register dump in front of it says which side is broken:
+	 *   DAIF.I set        -> IRQs are masked at the CPU, nothing can arrive
+	 *   CNTV_CTL.ISTATUS  -> the counter already expired: the tick fired but
+	 *                        was never taken (GIC side)
+	 *   CNTV_CTL.ENABLE=0 -> the decrementer was never armed
+	 *   ICC_PMR / IGRPEN1 -> CPU interface not open for the group in use
+	 */
+	{
+		extern void dandelion_trace_mark(const char *);
+		uint64_t _daif, _ctl, _tval, _sre, _pmr = 0xdead, _igrp1 = 0xdead;
+		uint64_t _hppir1 = 0xdead, _rpr = 0xdead;
+
+		__builtin_arm_isb(ISB_SY);
+		_daif = __builtin_arm_rsr64("DAIF");
+		_ctl = __builtin_arm_rsr64("CNTV_CTL_EL0");
+		_tval = __builtin_arm_rsr64("CNTV_TVAL_EL0");
+		_sre = __builtin_arm_rsr64("ICC_SRE_EL1");
+		if (_sre & 1) {
+			_pmr = __builtin_arm_rsr64("ICC_PMR_EL1");
+			_igrp1 = __builtin_arm_rsr64("ICC_IGRPEN1_EL1");
+			_hppir1 = __builtin_arm_rsr64("ICC_HPPIR1_EL1");
+			_rpr = __builtin_arm_rsr64("ICC_RPR_EL1");
+		}
+		printf("[dl] regs daif=%llx ctl=%llx tval=%llx sre=%llx pmr=%llx igrp1=%llx\n",
+		    (unsigned long long)_daif, (unsigned long long)_ctl,
+		    (unsigned long long)_tval, (unsigned long long)_sre,
+		    (unsigned long long)_pmr, (unsigned long long)_igrp1);
+		printf("[dl] regs hppir1=%llx(1023=spurious) rpr=%llx\n",
+		    (unsigned long long)_hppir1, (unsigned long long)_rpr);
+
+		dandelion_trace_mark("[dl] timerprobe: before IOSleep(200)\n");
+		IOSleep(200);
+		dandelion_trace_mark("[dl] timerprobe: after IOSleep(200)\n");
+	}
+#endif
 	while (TRUE) {
 		int err;
 
@@ -868,8 +929,39 @@ bsd_init(void)
 
 		bsd_init_kprintf("vfs_mountroot\n");
 		if (0 == (err = vfs_mountroot())) {
+#if defined(DANDELION)
+			{
+				extern void dandelion_trace_mark(const char *);
+				dandelion_trace_mark("[dl] root mount: success\n");
+			}
+#endif
 			break;
 		}
+#if defined(DANDELION)
+		{
+			extern void dandelion_trace_mark(const char *);
+			char _buf[128];
+			static int _mount_fail_count;
+
+			_mount_fail_count++;
+			snprintf(_buf, sizeof(_buf),
+			    "[dl] root mount: fail errno=%d (attempt %d)\n",
+			    err, _mount_fail_count);
+			dandelion_trace_mark(_buf);
+
+			/*
+			 * Bring-up: we have no real root device.  Cap retries so
+			 * the panel shows the failure instead of an infinite
+			 * silent loop, and so the kernel can continue to the
+			 * next boot stage (which will panic with a useful
+			 * message rather than hang forever).
+			 */
+			if (_mount_fail_count >= 3) {
+				dandelion_trace_mark("[dl] root mount: giving up\n");
+				break;
+			}
+		}
+#endif
 		rootdevice[0] = '\0';
 #if CONFIG_NETBOOT
 		if (netboot) {
diff --git a/iokit/bsddev/IOKitBSDInit.cpp b/iokit/bsddev/IOKitBSDInit.cpp
index 5219fb0..944f48e 100644
--- a/iokit/bsddev/IOKitBSDInit.cpp
+++ b/iokit/bsddev/IOKitBSDInit.cpp
@@ -683,10 +683,19 @@ IOFindBSDRoot( char * rootName, unsigned int rootNameSize,
 	assert(matching);
 	matching->setObject(gIOResourceMatchedKey, gIOBSDKey);
 
+#if defined(DANDELION)
+	printf("[dl] IOFindBSDRoot: waiting for the IOBSD resource (30 s)\n");
+#endif
 	if ((service = IOService::waitForMatchingService(matching, 30ULL * kSecondScale))) {
 		OSSafeReleaseNULL(service);
+#if defined(DANDELION)
+		printf("[dl] IOFindBSDRoot: resource matched\n");
+#endif
 	} else {
 		IOLog("!BSD\n");
+#if defined(DANDELION)
+		printf("[dl] IOFindBSDRoot: wait timed out after 30 s\n");
+#endif
 	}
 	matching->release();
 	matching = NULL;
@@ -904,6 +913,20 @@ IOFindBSDRoot( char * rootName, unsigned int rootNameSize,
 #if XNU_TARGET_OS_OSX && defined(__arm64__)
 			// The disk isn't found - have the user pick from System Recovery.
 			(void)IOSetRecoveryBoot(BSD_BOOTFAIL_MEDIA_MISSING, NULL, true);
+#elif defined(DANDELION)
+			/*
+			 * The open-source XNU tree ships neither HFS+/APFS nor a
+			 * memory-disk driver, so no root device can ever appear on
+			 * this port.  Do not panic: stay in the wait loop so the
+			 * kernel keeps running and the framebuffer console (the only
+			 * console this board has) stays readable.
+			 */
+			static boolean_t no_root_logged = FALSE;
+			if (!no_root_logged) {
+				no_root_logged = TRUE;
+				IOLog("DANDELION: no root filesystem can be mounted on this port "
+				    "(open-source XNU has no HFS+/APFS); kernel stays up\n");
+			}
 #elif XNU_TARGET_OS_IOS
 			panic("Failed to mount root device");
 #endif
