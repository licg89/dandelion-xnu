diff --git a/libkern/crypto/corecrypto_sha2.c b/libkern/crypto/corecrypto_sha2.c
index 7392f0c..5ca1ad2 100644
--- a/libkern/crypto/corecrypto_sha2.c
+++ b/libkern/crypto/corecrypto_sha2.c
@@ -31,6 +31,9 @@
 #include <libkern/libkern.h>
 #include <kern/debug.h>
 #include <corecrypto/ccdigest.h>
+#if defined(DANDELION)
+#include <corecrypto/ccsha2.h>
+#endif
 
 #if defined(CRYPTO_SHA2)
 
@@ -38,6 +41,22 @@ void
 SHA256_Init(SHA256_CTX *ctx)
 {
 	const struct ccdigest_info *di;
+#if defined(DANDELION)
+	/*
+	 * No crypto kext on this port, so nothing filled g_crypto_funcs in.  Use the
+	 * generic corecrypto SHA-256 that is already linked into the kernel instead
+	 * of dereferencing a NULL function table (see the 2026-10-31 devfs abort:
+	 * pc _SHA256_Init+0x10, far 0x30).
+	 */
+	if (g_crypto_funcs == NULL) {
+		di = ccsha256_di();
+		if (ccdigest_di_size(di) > sizeof(SHA256_CTX)) {
+			panic("%s: inconsistent size for SHA256 context", __FUNCTION__);
+		}
+		ccdigest_init(di, ctx->ctx);
+		return;
+	}
+#endif
 	di = g_crypto_funcs->ccsha256_di;
 
 	/* Make sure the context size for the digest info fits in the one we have */
@@ -52,6 +71,13 @@ void
 SHA256_Update(SHA256_CTX *ctx, const void *data, size_t len)
 {
 	const struct ccdigest_info *di;
+#if defined(DANDELION)
+	if (g_crypto_funcs == NULL) {
+		di = ccsha256_di();
+		ccdigest_update(di, ctx->ctx, len, data);
+		return;
+	}
+#endif
 	di = g_crypto_funcs->ccsha256_di;
 
 	g_crypto_funcs->ccdigest_update_fn(di, ctx->ctx, len, data);
@@ -61,6 +87,13 @@ void
 SHA256_Final(void *digest, SHA256_CTX *ctx)
 {
 	const struct ccdigest_info *di;
+#if defined(DANDELION)
+	if (g_crypto_funcs == NULL) {
+		di = ccsha256_di();
+		ccdigest_final(di, ctx->ctx, digest);
+		return;
+	}
+#endif
 	di = g_crypto_funcs->ccsha256_di;
 
 	ccdigest_final(di, ctx->ctx, digest);
@@ -70,6 +103,11 @@ void
 SHA384_Init(SHA384_CTX *ctx)
 {
 	const struct ccdigest_info *di;
+#if defined(DANDELION)
+	if (g_crypto_funcs == NULL) {
+		panic("DANDELION: no crypto kext and no built-in %s di", __FUNCTION__);
+	}
+#endif
 	di = g_crypto_funcs->ccsha384_di;
 
 	/* Make sure the context size for the digest info fits in the one we have */
@@ -103,6 +141,11 @@ void
 SHA512_Init(SHA512_CTX *ctx)
 {
 	const struct ccdigest_info *di;
+#if defined(DANDELION)
+	if (g_crypto_funcs == NULL) {
+		panic("DANDELION: no crypto kext and no built-in %s di", __FUNCTION__);
+	}
+#endif
 	di = g_crypto_funcs->ccsha512_di;
 
 	/* Make sure the context size for the digest info fits in the one we have */
