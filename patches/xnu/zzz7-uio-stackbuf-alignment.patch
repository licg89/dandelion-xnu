diff --git a/bsd/sys/uio_internal.h b/bsd/sys/uio_internal.h
index 74a2036..532e88a 100644
--- a/bsd/sys/uio_internal.h
+++ b/bsd/sys/uio_internal.h
@@ -170,7 +170,52 @@ __END_DECLS
 #define UIO_SIZEOF( a_iovcount ) \
 	( sizeof(struct uio) + UIO_SIZEOF_IOVS(a_iovcount) )
 
-typedef char __attribute__((aligned(_Alignof(union iovecs)))) uio_stackbuf_t;
+/*
+ * uio_stackbuf_t - element type of a stack buffer of UIO_SIZEOF() bytes, passed
+ *	to uio_createwithbuffer().
+ *
+ * This used to be a typedef of a 1-byte type that claimed 8-byte alignment:
+ *
+ *	typedef char __attribute__((aligned(_Alignof(union iovecs)))) uio_stackbuf_t;
+ *
+ * Declaring an object of that type is legal, but declaring an *array* of it is
+ * not: the size of an array element has to be a multiple of its alignment, and
+ * 1 is not a multiple of 8.  clang 17 -- the only clang on the macos-15 runner,
+ * which has no Xcode 15 -- promoted that from an oddity nobody noticed into a
+ * hard error, at every one of the ~36 `uio_stackbuf_t buf[UIO_SIZEOF(n)]`
+ * declarations in bsd/ and security/:
+ *
+ *	bsd/vfs/vfs_attrlist.c:881:27: error: size of array element of type
+ *	'uio_stackbuf_t' (aka 'char') (1 bytes) isn't a multiple of its
+ *	alignment (8 bytes)
+ *
+ * Both properties are load-bearing, so neither may simply be dropped:
+ *
+ *  - it has to stay a 1-byte type, otherwise `buf[UIO_SIZEOF(n)]` is no longer
+ *    UIO_SIZEOF(n) bytes.  (Making the element type a struct with alignment 8
+ *    works, but makes every such buffer eight times too large; the buffer in
+ *    kpi_socket.c:730 is sized from msg_iovlen, so the worst case goes from
+ *    ~16 KB to ~131 KB of kernel stack.)
+ *  - the buffer has to be 8-byte aligned, because uio_createwithbuffer() casts
+ *    it straight to `struct uio *` and writes through that pointer, and
+ *    uio_addiov() then writes struct kern_iovec/user_iovec fields (8-byte
+ *    pointers and lengths) through a pointer derived from it.  Dropping the
+ *    attribute compiles, but then the buffer is only aligned by luck: as a
+ *    struct member it lands at offset 1, and the first uio_addiov() stores a
+ *    pointer there.
+ *
+ * So the alignment is kept and moved from the element type to the declared
+ * object: an over-aligned object is legal where an over-aligned array element
+ * is not.  This leaves every declaration site untouched -- including the
+ * variable-length one in kpi_socket.c and the `char *uio_bufp = &uio_buf[0]`
+ * alias in nfs_serv.c, which a uint64_t[]-based rewrite has to fix up.
+ *
+ * For the record, this is the diagnostic that made Apple give up on the typedef
+ * and introduce the UIO_STACKBUF(name, niov) macro in xnu-10002.1.13 (macOS
+ * 14.4), changing all call sites to `UIO_STACKBUF(buf, n)`; that is the
+ * alternative to fall back on if this form ever has to go.
+ */
+#define uio_stackbuf_t char __attribute__((aligned(_Alignof(union iovecs))))
 
 #define UIO_IS_USER_SPACE32( a_uio_t )  \
 	( (a_uio_t)->uio_segflg == UIO_USERSPACE32 || (a_uio_t)->uio_segflg == UIO_PHYS_USERSPACE32 || \
