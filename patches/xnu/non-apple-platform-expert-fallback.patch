diff --git a/iokit/Kernel/IOPlatformExpert.cpp b/iokit/Kernel/IOPlatformExpert.cpp
index 7a32a23..b2e1fb2 100644
--- a/iokit/Kernel/IOPlatformExpert.cpp
+++ b/iokit/Kernel/IOPlatformExpert.cpp
@@ -175,10 +175,19 @@ IOPlatformExpert::start( IOService * provider )
 	setPlatform( this );
 	gIOPlatform = this;
 
+#if defined(DANDELION)
+	printf("DANDELION: platform expert: instantiating power domains\n");
+#endif
 	PMInstantiatePowerDomains();
+#if defined(DANDELION)
+	printf("DANDELION: platform expert: power domains up\n");
+#endif
 
 #if !defined(__x86_64__)
 	publishPlatformUUIDAndSerial();
+#if defined(DANDELION)
+	printf("DANDELION: platform expert: uuid published\n");
+#endif
 #endif /* !defined(__x86_64__) */
 
 #if defined (__x86_64__)
@@ -191,6 +200,9 @@ IOPlatformExpert::start( IOService * provider )
 	PE_parse_boot_argn("enforce_platform_action_safety", &gEnforcePlatformActionSafety,
 	    sizeof(gEnforcePlatformActionSafety));
 
+#if defined(DANDELION)
+	printf("DANDELION: platform expert: configure\n");
+#endif
 	return configure(provider);
 }
 
@@ -2315,8 +2327,24 @@ IOPanicPlatform::start(IOService * provider)
 		platform_name = provider->getName();
 	}
 
+#if defined(DANDELION)
+	/*
+	 * This port ships no platform kext, so nothing better than this
+	 * personality can ever match the root nub.  Panicking here stops the
+	 * boot at the IOKit boundary; running the generic IOPlatformExpert
+	 * implementation instead still installs the global platform expert
+	 * (IOService::setPlatform()) that bsd_init() and the rest of IOKit
+	 * dereference unconditionally, so the boot can make progress and we
+	 * get to see the next real failure.
+	 */
+	printf("DANDELION: no platform driver for \"%s\", "
+	    "using the generic platform expert\n", platform_name);
+
+	return IOPlatformExpert::start(provider);
+#else
 	panic("Unable to find driver for this platform: \"%s\".",
 	    platform_name);
 
 	return false;
+#endif /* DANDELION */
 }
