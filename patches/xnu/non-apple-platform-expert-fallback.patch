diff --git a/iokit/Kernel/IOPlatformExpert.cpp b/iokit/Kernel/IOPlatformExpert.cpp
index 7a32a23..e236324 100644
--- a/iokit/Kernel/IOPlatformExpert.cpp
+++ b/iokit/Kernel/IOPlatformExpert.cpp
@@ -175,10 +175,19 @@ IOPlatformExpert::start( IOService * provider )
 	setPlatform( this );
 	gIOPlatform = this;
 
+#if defined(DANDELION)
+	printf("DANDELION: platform expert: instantiating power domains\n");
+#endif
 	PMInstantiatePowerDomains();
+#if defined(DANDELION)
+	printf("DANDELION: platform expert: power domains up\n");
+#endif
 
 #if !defined(__x86_64__)
 	publishPlatformUUIDAndSerial();
+#if defined(DANDELION)
+	printf("DANDELION: platform expert: uuid published\n");
+#endif
 #endif /* !defined(__x86_64__) */
 
 #if defined (__x86_64__)
@@ -191,6 +200,26 @@ IOPlatformExpert::start( IOService * provider )
 	PE_parse_boot_argn("enforce_platform_action_safety", &gEnforcePlatformActionSafety,
 	    sizeof(gEnforcePlatformActionSafety));
 
+#if defined(DANDELION)
+	printf("DANDELION: platform expert: configure\n");
+	{
+		extern uint32_t dandelion_gic_arch_rev;
+		extern uint32_t dandelion_gic_pidr2;
+		extern uint32_t dandelion_gic_typer;
+		extern uint64_t dandelion_gicr_typer_v;
+		extern uint32_t dandelion_gic_ctlr_pre;
+		extern uint32_t dandelion_gic_ctlr_post;
+		extern uint32_t dandelion_gic_igroupr_pre;
+		extern uint32_t dandelion_gic_igroupr_post;
+
+		printf("DANDELION: gic pidr2=%x arch=%u typer=%x gicr_typer=%lx\n",
+		    dandelion_gic_pidr2, dandelion_gic_arch_rev,
+		    dandelion_gic_typer, (unsigned long)dandelion_gicr_typer_v);
+		printf("DANDELION: gic ctlr %x -> %x, igroupr %x -> %x\n",
+		    dandelion_gic_ctlr_pre, dandelion_gic_ctlr_post,
+		    dandelion_gic_igroupr_pre, dandelion_gic_igroupr_post);
+	}
+#endif
 	return configure(provider);
 }
 
@@ -202,6 +231,9 @@ IOPlatformExpert::configure( IOService * provider )
 	IOService *         nub = NULL;
 
 	topLevel = OSDynamicCast( OSSet, getProperty("top-level"));
+#if defined(DANDELION)
+	printf("DANDELION: configure: topLevel=%p\n", (void *)topLevel);
+#endif
 
 	if (topLevel) {
 		while ((dict = OSDynamicCast( OSDictionary,
@@ -209,16 +241,31 @@ IOPlatformExpert::configure( IOService * provider )
 			dict->retain();
 			topLevel->removeObject( dict );
 			OSSafeReleaseNULL(nub);
+#if defined(DANDELION)
+			printf("DANDELION: configure: createNub\n");
+#endif
 			nub = createNub( dict );
 			dict->release();
 			if (NULL == nub) {
 				continue;
 			}
+#if defined(DANDELION)
+			printf("DANDELION: configure: attach\n");
+#endif
 			nub->attach( this );
+#if defined(DANDELION)
+			printf("DANDELION: configure: registerService\n");
+#endif
 			nub->registerService();
+#if defined(DANDELION)
+			printf("DANDELION: configure: registered\n");
+#endif
 		}
 	}
 	OSSafeReleaseNULL(nub);
+#if defined(DANDELION)
+	printf("DANDELION: configure: done\n");
+#endif
 	return true;
 }
 
@@ -2315,8 +2362,24 @@ IOPanicPlatform::start(IOService * provider)
 		platform_name = provider->getName();
 	}
 
+#if defined(DANDELION)
+	/*
+	 * This port ships no platform kext, so nothing better than this
+	 * personality can ever match the root nub.  Panicking here stops the
+	 * boot at the IOKit boundary; running the generic IOPlatformExpert
+	 * implementation instead still installs the global platform expert
+	 * (IOService::setPlatform()) that bsd_init() and the rest of IOKit
+	 * dereference unconditionally, so the boot can make progress and we
+	 * get to see the next real failure.
+	 */
+	printf("DANDELION: no platform driver for \"%s\", "
+	    "using the generic platform expert\n", platform_name);
+
+	return IOPlatformExpert::start(provider);
+#else
 	panic("Unable to find driver for this platform: \"%s\".",
 	    platform_name);
 
 	return false;
+#endif /* DANDELION */
 }
