diff --git a/osfmk/kern/printf.c b/osfmk/kern/printf.c
index 9b36f99..6f793ac 100644
--- a/osfmk/kern/printf.c
+++ b/osfmk/kern/printf.c
@@ -1253,9 +1253,42 @@ dandelion_trace_attach(void)
 	dandelion_trace_base = (volatile unsigned char *)DANDELION_TRACE_PA;
 }
 
+/*
+ * Serialising the console writers (DANDELION).
+ *
+ * Every one of these writers is called from both thread and interrupt context:
+ * the kernel's own printf(), the checkpoints, and - since the tick works - the
+ * markers in sleh_irq()/rtclock_intr().  They all share mutable state (a 512-byte
+ * sector buffer, a ring cursor, the framebuffer cursor), so a timer interrupt
+ * arriving in the middle of a line interleaves the two writers, corrupts the
+ * buffer index, and stops all output.  That is exactly what the 01:3x boot did.
+ *
+ * dl_irq_save() returns the previous DAIF, so nesting is safe: in
+ * interrupt context it reports I already set and restoring leaves them masked.
+ */
+static inline unsigned long
+dl_irq_save(void)
+{
+	unsigned long daif;
+
+	__asm__ volatile("mrs %0, DAIF" : "=r"(daif));
+	__asm__ volatile("msr DAIFSet, #2" ::: "memory");
+	return daif;
+}
+
+static inline void
+dl_irq_restore(unsigned long daif)
+{
+	__asm__ volatile("msr DAIF, %0" : : "r"(daif) : "memory");
+}
+
+#define DL_WRITER_LOCK()    unsigned long _dl_daif = dl_irq_save()
+#define DL_WRITER_UNLOCK()  dl_irq_restore(_dl_daif)
+
 void
 dandelion_trace_putc(char c)
 {
+	DL_WRITER_LOCK();
 	volatile unsigned char *base = dandelion_trace_base;
 	volatile unsigned int *hdr;
 	unsigned int off = dandelion_trace_len;
@@ -1295,6 +1328,7 @@ dandelion_trace_putc(char c)
 
 	__asm__ volatile("dc cvac, %0" :: "r"((unsigned long)(base + DANDELION_TRACE_HDR + off) & ~63UL) : "memory");
 	__asm__ volatile("dsb sy" ::: "memory");
+	DL_WRITER_UNLOCK();
 }
 
 void
@@ -1782,13 +1816,17 @@ dl_emmc_flush_sector(void)
 void
 dandelion_emmc_putc(char c)
 {
+	DL_WRITER_LOCK();
+
 	if (!dl_emmc_ready) {
 		if (dl_emmc_ring_len < sizeof(dl_emmc_ring)) {
 			dl_emmc_ring[dl_emmc_ring_len++] = (unsigned char)c;
 		}
+		DL_WRITER_UNLOCK();
 		return;
 	}
 	if (dl_emmc_failed) {
+		DL_WRITER_UNLOCK();
 		return;
 	}
 
@@ -1805,6 +1843,7 @@ dandelion_emmc_putc(char c)
 		 * kernel that dies is the last line it managed to print. */
 		dl_emmc_flush_sector();
 	}
+	DL_WRITER_UNLOCK();
 }
 
