+#if defined(DANDELION)
+/*
+ * Translate one VA with the current tables and return PAR_EL1.  Bit 0 tells success
+ * from fault; bits [63:56] carry the attribute and shareability hints, which is what
+ * makes two mappings of the same page comparable.
+ */
+static unsigned long
+dl_at_s1e1r(unsigned long va)
+{
+	unsigned long par;
+
+	__asm__ volatile("at s1e1r, %0" : : "r"(va) : "memory");
+	__asm__ volatile("isb" ::: "memory");
+	__asm__ volatile("mrs %0, PAR_EL1" : "=r"(par));
+	return par;
+}
+#endif
+
