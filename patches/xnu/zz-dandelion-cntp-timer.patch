diff --git a/osfmk/arm64/machine_routines.c b/osfmk/arm64/machine_routines.c
index 76582da..4510431 100644
--- a/osfmk/arm64/machine_routines.c
+++ b/osfmk/arm64/machine_routines.c
@@ -2035,7 +2035,8 @@ ml_set_decrementer(uint32_t dec_value)
 	if (cdp->cpu_set_decrementer_func) {
 		cdp->cpu_set_decrementer_func(dec_value);
 	} else {
-		__builtin_arm_wsr64("CNTV_TVAL_EL0", (uint64_t)dec_value);
+		/* dandelion: PPI 30 (CNTP) is the timer interrupt non-secure owns. */
+		__builtin_arm_wsr64("CNTP_TVAL_EL0", (uint64_t)dec_value);
 	}
 }
 
@@ -2156,7 +2157,7 @@ ml_get_decrementer(void)
 	} else {
 		uint64_t wide_val;
 
-		wide_val = __builtin_arm_rsr64("CNTV_TVAL_EL0");
+		wide_val = __builtin_arm_rsr64("CNTP_TVAL_EL0");
 		dec = (uint32_t)wide_val;
 		assert(wide_val == (uint64_t)dec);
 	}
@@ -2167,8 +2168,8 @@ ml_get_decrementer(void)
 boolean_t
 ml_get_timer_pending(void)
 {
-	uint64_t cntv_ctl = __builtin_arm_rsr64("CNTV_CTL_EL0");
-	return ((cntv_ctl & CNTV_CTL_EL0_ISTATUS) != 0) ? TRUE : FALSE;
+	uint64_t cntp_ctl = __builtin_arm_rsr64("CNTP_CTL_EL0");
+	return ((cntp_ctl & CNTP_CTL_EL0_ISTATUS) != 0) ? TRUE : FALSE;
 }
 
 __attribute__((noreturn))
@@ -2242,11 +2243,18 @@ _enable_timebase_event_stream(uint32_t bit_index)
 static void
 _enable_virtual_timer(void)
 {
-	uint64_t cntvctl = CNTV_CTL_EL0_ENABLE; /* One wants to use 32 bits, but "mrs" prefers it this way */
+	/*
+	 * dandelion: the timer interrupt left to EL1 non-secure on this platform is
+	 * PPI 30 -- the physical timer -- which is the one Linux uses here too
+	 * (/proc/interrupts: "GICv3 30 Level arch_timer").  The virtual timer's PPI
+	 * 27 is not a Group 1 NS interrupt on this GIC, so arming CNTV produces a
+	 * pending local interrupt that nobody ever receives: every deadline sleep
+	 * then blocks forever.  Arm CNTP and mask CNTV instead.
+	 */
+	uint64_t cntpctl = CNTP_CTL_EL0_ENABLE;
 
-	__builtin_arm_wsr64("CNTV_CTL_EL0", cntvctl);
-	/* disable the physical timer as a precaution, as its registers reset to architecturally unknown values */
-	__builtin_arm_wsr64("CNTP_CTL_EL0", CNTP_CTL_EL0_IMASKED);
+	__builtin_arm_wsr64("CNTP_CTL_EL0", cntpctl);
+	__builtin_arm_wsr64("CNTV_CTL_EL0", CNTV_CTL_EL0_IMASKED);
 }
 
 void
