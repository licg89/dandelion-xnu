+/*
+ * Scroll the text region up by one line.  Only the left-hand text columns
+ * are moved, so the probe bars on the right survive.  Each moved row is
+ * cleaned from the D-cache as we go: the framebuffer is normal cacheable
+ * memory, and nothing would otherwise reach the display controller.
+ */
+static void
+dandelion_fb_scroll(void)
+{
+	unsigned int y;
+	const unsigned int xmax = DANDELION_PROBE_X - 8;
+
+	for (y = DANDELION_FB_Y0; y + 16 < DANDELION_FB_YMAX; y++) {
+		volatile unsigned int *dst = (volatile unsigned int *)
+		    (DANDELION_FB_PA + (unsigned long)y * DANDELION_FB_STRIDE);
+		volatile unsigned int *src = (volatile unsigned int *)
+		    (DANDELION_FB_PA + (unsigned long)(y + 16) * DANDELION_FB_STRIDE);
+
+		for (unsigned int x = 0; x < xmax; x++) {
+			dst[x] = src[x];
+		}
+	}
+	for (; y < DANDELION_FB_YMAX; y++) {
+		volatile unsigned int *dst = (volatile unsigned int *)
+		    (DANDELION_FB_PA + (unsigned long)y * DANDELION_FB_STRIDE);
+
+		for (unsigned int x = 0; x < xmax; x++) {
+			dst[x] = DANDELION_FB_BG;
+		}
+	}
+
+	for (y = DANDELION_FB_Y0; y < DANDELION_FB_YMAX; y++) {
+		unsigned long a = (unsigned long)(DANDELION_FB_PA +
+		    (unsigned long)y * DANDELION_FB_STRIDE);
+		unsigned long end = a + (unsigned long)xmax * 4;
+
+		for (; a < end; a += 64) {
+			__asm__ volatile("dc cvac, %0" :: "r"(a) : "memory");
+		}
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
+/* Advance to the next text line, scrolling once the region is full. */
+static void
+dandelion_fb_newline(void)
+{
+	dandelion_fb_x = DANDELION_FB_X0;
+	dandelion_fb_y += 16;
+	if (dandelion_fb_y + 16 > DANDELION_FB_YMAX) {
+		dandelion_fb_scroll();
+		dandelion_fb_y = DANDELION_FB_YMAX - 16;
+	}
+}
+
+static void
+dandelion_fb_putc(char c)
+{
+	if (!dandelion_fb_live) {
+		return;
+	}
+	if (c == '\n') {
+		dandelion_fb_newline();
+		return;
+	}
+	if (c == '\r') {
+		dandelion_fb_x = DANDELION_FB_X0;
+		return;
+	}
+	if (c < 0x20 || c > 0x7e) {
+		c = '?';
+	}
+	if (dandelion_fb_x + 8 > DANDELION_FB_VISW) {
+		dandelion_fb_newline();
+	}
+	if (dandelion_fb_y + 16 > DANDELION_FB_YMAX) {
+		return;
+	}
+
+	const unsigned char *g = dandelion_font8x16[c - 0x20];
+	volatile unsigned int *row = (volatile unsigned int *)
+	    (DANDELION_FB_PA + (unsigned long)dandelion_fb_y * DANDELION_FB_STRIDE +
+	    dandelion_fb_x * 4);
+
+	for (int r = 0; r < 16; r++) {
+		unsigned char bits = g[r];
+
+		for (int b = 0; b < 8; b++) {
+			row[b] = (bits & (0x80 >> b)) ? DANDELION_FB_FG : DANDELION_FB_BG;
+		}
+		__asm__ volatile("dc cvac, %0" :: "r"((unsigned long)row & ~63UL) : "memory");
+		__asm__ volatile("dc cvac, %0" :: "r"(((unsigned long)row & ~63UL) + 64) : "memory");
+		row = (volatile unsigned int *)((unsigned long)row + DANDELION_FB_STRIDE);
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+
+	dandelion_fb_x += 8;
+}
