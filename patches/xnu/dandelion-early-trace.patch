+/*
+ * Dandelion early boot trace.
+ *
+ * This board has no serial port, and the framebuffer text console does not
+ * exist until PE_create_console() runs in arm_init(), so a hang in the first
+ * few thousand instructions leaves no evidence at all.  Every character that
+ * reaches the console is therefore also appended to a fixed buffer inside the
+ * kernel's physical window; the boot shim reads that buffer back on the next
+ * boot (after the watchdog resets the phone) and prints it on the panel.
+ *
+ * The hook lives in _cnputc(), which every console write funnels through:
+ * kprintf() (via PE_kputc/console_write_unbuffered), printf() (via
+ * console_write), and the panic path (consdebug_putc*).  arm_init.c and
+ * startup.c additionally append plain checkpoints with dandelion_trace_mark()
+ * so progress is visible even where nothing prints.
+ *
+ * The buffer sits near the top of the window, far above topOfKernelData and
+ * therefore not handed out by the VM during early boot.  It cannot sit at
+ * the very top: the bootstrap V=P mapping that start.s builds stops at the
+ * last whole 2 MiB block below gPhysBase + memSize (0x5fe00000 for this
+ * 384 MiB window), and everything above that is unmapped until arm_vm_init()
+ * installs the physmap.
+ *
+ * Until then the window is reachable through that identity map, so the
+ * physical address works as-is.  arm_vm_init() calls dandelion_trace_attach()
+ * right after the switch, which repoints the buffer at the physmap; the few
+ * lines in between are the only blind spot.
+ *
+ * The mappings are cacheable, so every character is cleaned to the point of
+ * coherency: the interesting part of the trace is whatever was written last,
+ * which is exactly what would still be sitting dirty in a cache when the
+ * watchdog fires.
+ */
+#define DANDELION_TRACE_PA      0x5fc00000UL
+#define DANDELION_TRACE_SIZE    0x40000UL
+/* "XTX1": lets the shim tell a real trace from leftovers in RAM. */
+#define DANDELION_TRACE_MAGIC   0x58545831U
+#define DANDELION_TRACE_HDR     8
+#define DANDELION_TRACE_TEXT    (DANDELION_TRACE_SIZE - DANDELION_TRACE_HDR)
