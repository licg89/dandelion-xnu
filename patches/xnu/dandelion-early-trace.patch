+/*
+ * Paint a solid probe bar.  Used to bracket the arm_vm_init() call: the
+ * bar is written straight into the panel's own pixel rows, independent of
+ * the text cursor and of the trace buffer, and the D-cache lines are
+ * cleaned afterwards so the display controller actually sees the pixels.
+ */
+void
+dandelion_probe_bar(unsigned int row, unsigned int color)
+{
+	volatile unsigned int *p = (volatile unsigned int *)
+	    (DANDELION_FB_PA + (unsigned long)row * DANDELION_FB_STRIDE +
+	    (unsigned long)DANDELION_PROBE_X * 4);
+	unsigned long base = (unsigned long)p & ~63UL;
+	unsigned long bytes = ((unsigned long)DANDELION_PROBE_W * 4 + 63UL) & ~63UL;
+
+	for (unsigned int i = 0; i < DANDELION_PROBE_W; i++) {
+		p[i] = color;
+	}
+	for (unsigned long i = 0; i < bytes; i += 64) {
+		__asm__ volatile("dc cvac, %0" :: "r"(base + i) : "memory");
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+}
