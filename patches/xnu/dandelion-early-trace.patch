+	    (unsigned long)DANDELION_PROBE_X * 4);
+	unsigned long base = (unsigned long)p & ~63UL;
+	unsigned long bytes = ((unsigned long)DANDELION_PROBE_W * 4 + 63UL) & ~63UL;
+
+	for (unsigned int i = 0; i < DANDELION_PROBE_W; i++) {
+		p[i] = color;
+	}
+	for (unsigned long i = 0; i < bytes; i += 64) {
+		__asm__ volatile("dc cvac, %0" :: "r"(base + i) : "memory");
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
+static volatile unsigned char *dandelion_trace_base =
+    (volatile unsigned char *)DANDELION_TRACE_PA;
+static volatile unsigned int dandelion_trace_len;
+
+void
+dandelion_trace_attach(void)
+{
+	/*
+	 * The physmap is not a flat gPhysBase-relative window: arm_vm_init()
+	 * lays its segments out through ptov_table with per-segment block
+	 * alignment, so ask the kernel where the page landed rather than
+	 * computing it.
+	 */
+	dandelion_trace_base =
+	    (volatile unsigned char *)phystokv(DANDELION_TRACE_PA);
+
+	/*
+	 * arm_vm_init() keeps the bootstrap V=P map in TTBR0 for bring-up
+	 * (DANDELION_KEEP_IDENTITY_MAP), so the panel is still reachable at its
+	 * physical address and the trace keeps painting.
+	 */
+}
+
+void
+dandelion_trace_putc(char c)
+{
+	volatile unsigned char *base = dandelion_trace_base;
+	volatile unsigned int *hdr;
+	unsigned int off = dandelion_trace_len;
+
+	if (base == NULL) {
+		return;
+	}
+	hdr = (volatile unsigned int *)base;
+	if (hdr[0] != DANDELION_TRACE_MAGIC) {
+		hdr[0] = DANDELION_TRACE_MAGIC;
+		off = 0;
+	}
+	if (off >= (DANDELION_TRACE_TEXT - 2)) {
+		/*
+		 * Full.  Drop the oldest half instead of the newest: the text
+		 * that describes the hang is the text written last.
+		 */
+		unsigned int half = DANDELION_TRACE_TEXT / 2;
+		unsigned int i;
+
+		for (i = 0; i < half; i++) {
+			base[DANDELION_TRACE_HDR + i] =
+			    base[DANDELION_TRACE_HDR + i + half];
+		}
+		off -= half;
+
+		/* The shifted copy is dirty in the cache; push it all out. */
+		for (i = 0; i < DANDELION_TRACE_SIZE; i += 64) {
+			__asm__ volatile("dc cvac, %0" :: "r"((unsigned long)(base + i)) : "memory");
+		}
+		__asm__ volatile("dsb sy" ::: "memory");
+	}
+	base[DANDELION_TRACE_HDR + off] = (unsigned char)c;
+	base[DANDELION_TRACE_HDR + off + 1] = 0;
+	hdr[1] = off + 1;
+	dandelion_trace_len = off + 1;
+
+	__asm__ volatile("dc cvac, %0" :: "r"((unsigned long)(base + DANDELION_TRACE_HDR + off) & ~63UL) : "memory");
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
+void
+dandelion_trace_mark(const char *s)
+{
+	while (*s != '\0') {
+		char c = *s++;
+
+		dandelion_trace_putc(c);
+		dandelion_fb_putc(c);
+	}
+}
+
+/* Board constants for the log channel live with the other Dandelion
+ * definitions; the shim includes the same header, so the hand-off layout
+ * cannot drift. */
+#include <pexpert/arm64/DANDELION.h>
+
+/*
+ * ---------------------------------------------------------------------
+ * Dandelion eMMC log channel
+ * ---------------------------------------------------------------------
+ *
+ * The panel is only readable by photographing it, and the ramoops ring dies
+ * with the machine.  This kernel has a habit of resetting without saying
+ * anything, so the console is streamed to the unused `flashinfo` partition
+ * through a polled PIO writer instead.
+ *
+ * Only the *write* half lives here.  Card bring-up, the GPT lookup and the
+ * choice of a free run are the boot shim's job (bootshim/msdc.c): inheriting
+ * LK's card state is a one-shot opportunity, and the shim is the stage that
+ * can still report a failure on the panel.  The shim publishes the LBA of the
+ * kernel's block through struct dandelion_emmc_handoff in DANDELION.h.
+ *
+ * The block format is bootshim/log_block.h; the offsets are repeated here
+ * because osfmk cannot include the shim's headers.  See docs/EMMC-LOG.md.
+ */
+#define DL_EMMC_SECTOR         512
+#define DL_EMMC_RING           (16 * 1024)
+#define DL_EMMC_HEADER_EVERY   8        /* sectors between header updates */
+
+/* MSDC0 registers, see bootshim/msdc.c for the annotated table */
+#define DL_MSDC_CFG            0x000
+#define DL_MSDC_INT            0x00C
+#define DL_MSDC_INTEN          0x010
+#define DL_MSDC_FIFOCS         0x014
+#define DL_MSDC_TXDATA         0x018
+#define DL_MSDC_SDC_CMD        0x034
+#define DL_MSDC_SDC_ARG        0x038
+#define DL_MSDC_SDC_STS        0x03C
+#define DL_MSDC_RESP0          0x040
+#define DL_MSDC_BLK_NUM        0x050
+
+#define DL_CFG_PIO             (1u << 3)
+#define DL_CFG_CKSTB           (1u << 7)
+#define DL_STS_SDCBUSY         (1u << 0)
+#define DL_STS_CMDBUSY         (1u << 1)
+#define DL_INT_CMDRDY          (1u << 8)
+#define DL_INT_CMDTMO          (1u << 9)
+#define DL_INT_RSPCRCERR       (1u << 10)
+#define DL_INT_XFER_COMPL      (1u << 12)
+#define DL_INT_DATTMO          (1u << 14)
+#define DL_INT_DATCRCERR       (1u << 15)
+#define DL_INT_CMD_ALL         (DL_INT_CMDRDY | DL_INT_CMDTMO | DL_INT_RSPCRCERR)
+#define DL_INT_DAT_ALL         (DL_INT_XFER_COMPL | DL_INT_DATTMO | DL_INT_DATCRCERR)
+#define DL_FIFOCS_TXCNT(x)     (((x) >> 16) & 0xFFu)
+#define DL_FIFOCS_CLR          (1u << 31)
+#define DL_FIFO_DEPTH          128u
+#define DL_CMD13_W             0x0000008Du
+#define DL_CMD24_W             0x02002898u
+#define DL_R1_READY_FOR_DATA   (1u << 8)
+#define DL_R1_STATE(s)         (((s) >> 9) & 0xFu)
+#define DL_R1_STATE_TRAN       4u
+#define DL_R1_FATAL_MASK       0xFFFFA080u
+
+/* log block header offsets, identical to bootshim/log_block.h */
+#define DL_LOG_MAGIC           "DLXLOG01"
+#define DL_LOG_VERSION         1
+#define DL_LOG_SLOT_SIZE       (64 * 1024)
+#define DL_LOG_SLOTS           8
+#define DL_LOG_OFF_MAGIC       0x00
+#define DL_LOG_OFF_VERSION     0x08
+#define DL_LOG_OFF_HDR_BYTES   0x0C
+#define DL_LOG_OFF_BOOT        0x10
+#define DL_LOG_OFF_SLOT_COUNT  0x14
+#define DL_LOG_OFF_SLOT_SIZE   0x18
+#define DL_LOG_OFF_NEXT_SLOT   0x1C
+#define DL_LOG_OFF_TEXT_BYTES  0x20
+#define DL_LOG_OFF_CNTPCT      0x24
+#define DL_LOG_OFF_CNTFRQ      0x2C
+
+static volatile unsigned int *dl_emmc_reg;
+static uint32_t dl_emmc_lba;
+static uint32_t dl_emmc_sectors;
+static uint32_t dl_emmc_index;          /* sector index in the text area */
+static uint32_t dl_emmc_used;           /* bytes used in that sector     */
+static int dl_emmc_ready;
+static int dl_emmc_failed;
+static int dl_emmc_tried;
+static unsigned char dl_emmc_sector[DL_EMMC_SECTOR] __attribute__((aligned(64)));
+static unsigned char dl_emmc_ring[DL_EMMC_RING] __attribute__((aligned(64)));
+static unsigned int dl_emmc_ring_len;
+
+void dandelion_emmc_enable(void);
+
+static uint32_t
+dl_emmc_rd(unsigned int off)
+{
+	return dl_emmc_reg[off >> 2];
+}
+
+static void
+dl_emmc_wr(unsigned int off, uint32_t value)
+{
+	dl_emmc_reg[off >> 2] = value;
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
+/* Same trick as the shim: the generic counter is the only clock that is
+ * guaranteed to be running this early. */
+static uint64_t
+dl_emmc_now_ms(void)
+{
+	uint64_t count, freq;
+
+	__asm__ volatile("mrs %0, cntfrq_el0" : "=r"(freq));
+	__asm__ volatile("mrs %0, cntpct_el0" : "=r"(count));
+	if (freq == 0) {
+		return count / 10000;
+	}
+	return (count / freq) * 1000 + ((count % freq) * 1000) / freq;
+}
+
+/* The staging buffers are ordinary memory and the FIFO is a device, so every
+ * line has to be made visible to the card before it is handed over. */
+static void
+dl_emmc_clean(const void *addr, unsigned long bytes)
+{
+	unsigned long start = (unsigned long)addr & ~63UL;
+	unsigned long end = ((unsigned long)addr + bytes + 63UL) & ~63UL;
+	unsigned long p;
+
+	for (p = start; p < end; p += 64) {
+		__asm__ volatile("dc civac, %0" :: "r"(p) : "memory");
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
+static int
+dl_emmc_wait_sts(uint32_t mask, uint32_t ms)
+{
+	uint64_t deadline = dl_emmc_now_ms() + ms;
+
+	while (dl_emmc_rd(DL_MSDC_SDC_STS) & mask) {
+		if (dl_emmc_now_ms() > deadline) {
+			return -1;
+		}
+	}
+	return 0;
+}
+
+static int
+dl_emmc_fifo_clear(void)
+{
+	uint64_t deadline = dl_emmc_now_ms() + 20;
+
+	dl_emmc_wr(DL_MSDC_FIFOCS, dl_emmc_rd(DL_MSDC_FIFOCS) | DL_FIFOCS_CLR);
+	while (dl_emmc_rd(DL_MSDC_FIFOCS) & DL_FIFOCS_CLR) {
+		if (dl_emmc_now_ms() > deadline) {
+			return -1;
+		}
+	}
+	return 0;
+}
+
+static int
+dl_emmc_cmd(uint32_t cmdw, uint32_t arg, uint32_t *r1, uint32_t ms)
+{
+	uint32_t opcode = cmdw & 0x3Fu;
+	uint64_t deadline;
+
+	if (dl_emmc_wait_sts((opcode == 13u) ? DL_STS_CMDBUSY : DL_STS_SDCBUSY,
+	    100)) {
+		return -1;
+	}
+
+	dl_emmc_wr(DL_MSDC_INT, DL_INT_CMD_ALL);
+	dl_emmc_wr(DL_MSDC_SDC_ARG, arg);
+	dl_emmc_wr(DL_MSDC_SDC_CMD, cmdw);
+
+	deadline = dl_emmc_now_ms() + ms;
+	for (;;) {
+		uint32_t status = dl_emmc_rd(DL_MSDC_INT) & DL_INT_CMD_ALL;
+
+		if (status) {
+			dl_emmc_wr(DL_MSDC_INT, status);
+			if (status & DL_INT_CMDTMO) {
+				return -2;
+			}
+			if (status & DL_INT_RSPCRCERR) {
+				return -3;
+			}
+			if (r1) {
+				*r1 = dl_emmc_rd(DL_MSDC_RESP0);
+			}
+			return 0;
+		}
+		if (dl_emmc_now_ms() > deadline) {
+			return -4;
+		}
+	}
+}
+
+static int
+dl_emmc_wait_ready(uint32_t ms)
+{
+	uint64_t deadline = dl_emmc_now_ms() + ms;
+
+	for (;;) {
+		uint32_t r1 = 0;
+
+		if (dl_emmc_cmd(DL_CMD13_W, 1u << 16, &r1, 50) == 0) {
+			if (r1 & DL_R1_FATAL_MASK) {
+				return -1;
+			}
+			if (DL_R1_STATE(r1) == DL_R1_STATE_TRAN &&
+			    (r1 & DL_R1_READY_FOR_DATA)) {
+				return 0;
+			}
+		}
+		if (dl_emmc_now_ms() > deadline) {
+			return -1;
+		}
+	}
+}
+
+/* One sector, one CMD24.  Multi-block would be faster, but the console
+ * produces a trickle and single-block removes the CMD12 state machine. */
+static int
+dl_emmc_write_block(uint32_t lba, const void *buf)
+{
+	const unsigned char *p = (const unsigned char *)buf;
+	uint32_t response = 0, status;
+	uint64_t deadline;
+	unsigned int sent = 0;
+
+	if (dl_emmc_wait_sts(DL_STS_SDCBUSY, 100) || dl_emmc_fifo_clear()) {
+		return -1;
+	}
+
+	dl_emmc_wr(DL_MSDC_BLK_NUM, 1);
+	dl_emmc_wr(DL_MSDC_INT, DL_INT_DAT_ALL);
+
+	if (dl_emmc_cmd(DL_CMD24_W, lba, &response, 200)) {
+		return -2;
+	}
+	if (response & DL_R1_FATAL_MASK) {
+		return -3;
+	}
+
+	deadline = dl_emmc_now_ms() + 2000;
+	for (;;) {
+		status = dl_emmc_rd(DL_MSDC_INT) & DL_INT_DAT_ALL;
+		if (status) {
+			dl_emmc_wr(DL_MSDC_INT, status);
+			if (status & (DL_INT_DATTMO | DL_INT_DATCRCERR)) {
+				return -4;
+			}
+			if (status & DL_INT_XFER_COMPL) {
+				break;
+			}
+		}
+		if (sent < DL_EMMC_SECTOR &&
+		    DL_FIFOCS_TXCNT(dl_emmc_rd(DL_MSDC_FIFOCS)) == 0) {
+			unsigned int burst = DL_EMMC_SECTOR - sent;
+
+			if (burst > DL_FIFO_DEPTH) {
+				burst = DL_FIFO_DEPTH;
+			}
+			for (unsigned int i = 0; i < burst; i += 4) {
+				uint32_t word;
+
+				__builtin_memcpy(&word, p + sent + i, 4);
+				dl_emmc_reg[DL_MSDC_TXDATA >> 2] = word;
+			}
+			__asm__ volatile("dsb sy" ::: "memory");
+			sent += burst;
+		}
+		if (dl_emmc_now_ms() > deadline) {
+			return -5;
+		}
+	}
+
+	deadline = dl_emmc_now_ms() + 500;
+	while (DL_FIFOCS_TXCNT(dl_emmc_rd(DL_MSDC_FIFOCS)) != 0) {
+		if (dl_emmc_now_ms() > deadline) {
+			return -6;
+		}
+	}
+
+	return dl_emmc_wait_ready(2000);
+}
+
+static void
+dl_put_le32(unsigned char *p, uint32_t v)
+{
+	p[0] = (unsigned char)v;
+	p[1] = (unsigned char)(v >> 8);
+	p[2] = (unsigned char)(v >> 16);
+	p[3] = (unsigned char)(v >> 24);
+}
+
+static void
+dl_put_le64(unsigned char *p, uint64_t v)
+{
+	dl_put_le32(p, (uint32_t)v);
+	dl_put_le32(p + 4, (uint32_t)(v >> 32));
+}
+
+static uint32_t
+dl_emmc_text_bytes(void)
+{
+	return dl_emmc_index * DL_EMMC_SECTOR + dl_emmc_used;
+}
+
+static void
+dl_emmc_write_header(void)
+{
+	unsigned char header[DL_EMMC_SECTOR] __attribute__((aligned(64)));
+	uint32_t text = dl_emmc_text_bytes();
+	uint64_t count, freq;
+	int i;
+
+	for (i = 0; i < DL_EMMC_SECTOR; i++) {
+		header[i] = 0;
+	}
+	for (i = 0; i < 8; i++) {
+		header[DL_LOG_OFF_MAGIC + i] = (unsigned char)DL_LOG_MAGIC[i];
+	}
+	dl_put_le32(header + DL_LOG_OFF_VERSION, DL_LOG_VERSION);
+	dl_put_le32(header + DL_LOG_OFF_HDR_BYTES, DL_EMMC_SECTOR);
+	dl_put_le32(header + DL_LOG_OFF_BOOT, 0);
+	dl_put_le32(header + DL_LOG_OFF_SLOT_COUNT, DL_LOG_SLOTS);
+	dl_put_le32(header + DL_LOG_OFF_SLOT_SIZE, DL_LOG_SLOT_SIZE);
+	dl_put_le32(header + DL_LOG_OFF_NEXT_SLOT,
+	    (text + DL_LOG_SLOT_SIZE - 1) / DL_LOG_SLOT_SIZE);
+	dl_put_le32(header + DL_LOG_OFF_TEXT_BYTES, text);
+	__asm__ volatile("mrs %0, cntpct_el0" : "=r"(count));
+	__asm__ volatile("mrs %0, cntfrq_el0" : "=r"(freq));
+	dl_put_le64(header + DL_LOG_OFF_CNTPCT, count);
+	dl_put_le64(header + DL_LOG_OFF_CNTFRQ, freq);
+
+	dl_emmc_clean(header, DL_EMMC_SECTOR);
+	(void)dl_emmc_write_block(dl_emmc_lba, header);
+}
+
+static void
+dl_emmc_flush_sector(void)
+{
+	unsigned int i;
+
+	if (dl_emmc_failed) {
+		return;
+	}
+	if (dl_emmc_index + 1 >= dl_emmc_sectors) {
+		dl_emmc_failed = 1;
+		return;
+	}
+
+	for (i = dl_emmc_used; i < DL_EMMC_SECTOR; i++) {
+		dl_emmc_sector[i] = 0;
+	}
+	dl_emmc_clean(dl_emmc_sector, DL_EMMC_SECTOR);
+	if (dl_emmc_write_block(dl_emmc_lba + 1 + dl_emmc_index,
+	    dl_emmc_sector) != 0) {
+		dl_emmc_failed = 1;
+		return;
+	}
+
+	if ((dl_emmc_index % DL_EMMC_HEADER_EVERY) == 0) {
+		dl_emmc_write_header();
+	}
+}
+
+void
+dandelion_emmc_putc(char c)
+{
+	if (!dl_emmc_ready) {
+		/*
+		 * First character after the MMU came on: bring the channel up
+		 * now, so everything from here on reaches the medium.
+		 */
+		if (!dl_emmc_tried) {
+			dandelion_emmc_enable();
+		}
+		if (!dl_emmc_ready) {
+			if (dl_emmc_ring_len < sizeof(dl_emmc_ring)) {
+				dl_emmc_ring[dl_emmc_ring_len++] =
+				    (unsigned char)c;
+			}
+			return;
+		}
+	}
+	if (dl_emmc_failed) {
+		return;
+	}
+
+	dl_emmc_sector[dl_emmc_used++] = (unsigned char)c;
+	if (dl_emmc_used == DL_EMMC_SECTOR) {
+		dl_emmc_flush_sector();
+		dl_emmc_index++;
+		dl_emmc_used = 0;
+		for (unsigned int i = 0; i < DL_EMMC_SECTOR; i++) {
+			dl_emmc_sector[i] = 0;
+		}
+	} else if (c == '\n') {
+		/* Flush on every completed line: the interesting thing about a
+		 * kernel that dies is the last line it managed to print. */
+		dl_emmc_flush_sector();
+	}
+}
+
+/*
+ * Called once the VM can map device memory (arm_vm_init, right after
+ * pmap_bootstrap).  Everything printed before that is held in the RAM ring
+ * and written here, so the earliest messages are not lost either.
+ */
+void
+dandelion_emmc_enable(void)
+{
+	struct dandelion_emmc_handoff *handoff;
+	unsigned int i;
+
+	if (dl_emmc_tried) {
+		return;
+	}
+	dl_emmc_tried = 1;
+
+	/*
+	 * Both the hand-off record and the controller are reached through the
+	 * V=P bootstrap map that start.s builds and arm_vm_init keeps
+	 * (DANDELION_KEEP_IDENTITY_MAP), so neither phystokv() nor ml_io_map()
+	 * is involved: this runs from the very first console character, long
+	 * before the VM exists.
+	 */
+	handoff = (struct dandelion_emmc_handoff *)DANDELION_EMMC_HANDOFF_PA;
+	if (handoff->magic != DANDELION_EMMC_HANDOFF_MAGIC ||
+	    handoff->ok != 1 || handoff->sectors < 2) {
+		dl_emmc_failed = 1;
+		return;
+	}
+
+	dl_emmc_reg = (volatile unsigned int *)DANDELION_MSDC_VA;
+
+	if ((dl_emmc_rd(DL_MSDC_CFG) & DL_CFG_CKSTB) == 0) {
+		dl_emmc_failed = 1;
+		return;
+	}
+	dl_emmc_wr(DL_MSDC_INTEN, 0);
+	dl_emmc_wr(DL_MSDC_INT, 0xFFFFFFFFu);
+	if ((dl_emmc_rd(DL_MSDC_CFG) & DL_CFG_PIO) == 0) {
+		dl_emmc_wr(DL_MSDC_CFG, dl_emmc_rd(DL_MSDC_CFG) | DL_CFG_PIO);
+	}
+
+	dl_emmc_lba = handoff->lba;
+	dl_emmc_sectors = handoff->sectors;
+	dl_emmc_index = 0;
+	dl_emmc_used = 0;
+	for (i = 0; i < DL_EMMC_SECTOR; i++) {
+		dl_emmc_sector[i] = 0;
+	}
+	dl_emmc_ready = 1;
+
+	dl_emmc_write_header();
+
+	for (i = 0; i < dl_emmc_ring_len; i++) {
+		dandelion_emmc_putc((char)dl_emmc_ring[i]);
+	}
+	dl_emmc_ring_len = 0;
+	dl_emmc_write_header();
+}
+
+/*
+ * Console mirror: every character the kernel console emits is appended to
+ * the readback buffer and painted into the scrolling trace area, so the
+ * panel shows the real kprintf stream and not just the checkpoints.
+ */
+void
+dandelion_console_putc(char c)
+{
+	dandelion_trace_putc(c);
+	dandelion_fb_putc(c);
+	dandelion_emmc_putc(c);
+}
+#endif /* DANDELION */
