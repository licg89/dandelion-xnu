+	 * The physmap is not a flat gPhysBase-relative window: arm_vm_init()
+	 * lays its segments out through ptov_table with per-segment block
+	 * alignment, so ask the kernel where the page landed rather than
+	 * computing it.
+	 */
+	dandelion_trace_base =
+	    (volatile unsigned char *)phystokv(DANDELION_TRACE_PA);
+
+	/*
+	 * arm_vm_init() keeps the bootstrap V=P map in TTBR0 for bring-up
+	 * (DANDELION_KEEP_IDENTITY_MAP), so the panel is still reachable at its
+	 * physical address and the trace keeps painting.
+	 */
+}
+
+void
+dandelion_trace_putc(char c)
+{
+	volatile unsigned char *base = dandelion_trace_base;
+	volatile unsigned int *hdr;
+	unsigned int off = dandelion_trace_len;
+
+	if (base == NULL) {
+		return;
+	}
+	hdr = (volatile unsigned int *)base;
+	if (hdr[0] != DANDELION_TRACE_MAGIC) {
+		hdr[0] = DANDELION_TRACE_MAGIC;
+		off = 0;
+	}
+	if (off >= (DANDELION_TRACE_TEXT - 2)) {
+		/*
+		 * Full.  Drop the oldest half instead of the newest: the text
+		 * that describes the hang is the text written last.
+		 */
+		unsigned int half = DANDELION_TRACE_TEXT / 2;
+		unsigned int i;
+
+		for (i = 0; i < half; i++) {
+			base[DANDELION_TRACE_HDR + i] =
+			    base[DANDELION_TRACE_HDR + i + half];
+		}
+		off -= half;
+
+		/* The shifted copy is dirty in the cache; push it all out. */
+		for (i = 0; i < DANDELION_TRACE_SIZE; i += 64) {
+			__asm__ volatile("dc cvac, %0" :: "r"((unsigned long)(base + i)) : "memory");
+		}
+		__asm__ volatile("dsb sy" ::: "memory");
+	}
+	base[DANDELION_TRACE_HDR + off] = (unsigned char)c;
+	base[DANDELION_TRACE_HDR + off + 1] = 0;
+	hdr[1] = off + 1;
+	dandelion_trace_len = off + 1;
+
+	__asm__ volatile("dc cvac, %0" :: "r"((unsigned long)(base + DANDELION_TRACE_HDR + off) & ~63UL) : "memory");
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
+void
+dandelion_trace_mark(const char *s)
+{
+	while (*s != '\0') {
+		char c = *s++;
+
+		dandelion_trace_putc(c);
+		dandelion_fb_putc(c);
+	}
+}
+
+/*
+ * Console mirror: every character the kernel console emits is appended to
+ * the readback buffer and painted into the scrolling trace area, so the
+ * panel shows the real kprintf stream and not just the checkpoints.
+ */
+void
+dandelion_console_putc(char c)
+{
+	dandelion_trace_putc(c);
+	dandelion_fb_putc(c);
+}
