 	return vprintf_internal(fmt, ap, __builtin_return_address(0));
 }
 
+#if defined(DANDELION)
+/*
+ * Dandelion early boot trace.
+ *
+ * This board has no serial port, and the framebuffer text console does not
+ * exist until PE_create_console() runs in arm_init(), so a hang in the first
+ * few thousand instructions leaves no evidence at all.  Every character that
+ * reaches the console is therefore also appended to a fixed buffer inside the
+ * kernel's physical window; the boot shim reads that buffer back on the next
+ * boot (after the watchdog resets the phone) and prints it on the panel.
+ *
+ * The hook lives in _cnputc(), which every console write funnels through:
+ * kprintf() (via PE_kputc/console_write_unbuffered), printf() (via
+ * console_write), and the panic path (consdebug_putc*).  arm_init.c and
+ * startup.c additionally append plain checkpoints with dandelion_trace_mark()
+ * so progress is visible even where nothing prints.
+ *
+ * The buffer sits near the top of the window, far above topOfKernelData and
+ * therefore not handed out by the VM during early boot.  It cannot sit at
+ * the very top: the bootstrap V=P mapping that start.s builds stops at the
+ * last whole 2 MiB block below gPhysBase + memSize (0x5fe00000 for this
+ * 384 MiB window), and everything above that is unmapped until arm_vm_init()
+ * installs the physmap.
+ *
+ * Until then the window is reachable through that identity map, so the
+ * physical address works as-is.  arm_vm_init() calls dandelion_trace_attach()
+ * right after the switch, which repoints the buffer at the physmap; the few
+ * lines in between are the only blind spot.
+ *
+ * The mappings are cacheable, so every character is cleaned to the point of
+ * coherency: the interesting part of the trace is whatever was written last,
+ * which is exactly what would still be sitting dirty in a cache when the
+ * watchdog fires.
+ */
+#define DANDELION_TRACE_PA      0x5fc00000UL
+#define DANDELION_TRACE_SIZE    0x40000UL
+/* "XTX1": lets the shim tell a real trace from leftovers in RAM. */
+#define DANDELION_TRACE_MAGIC   0x58545831U
+#define DANDELION_TRACE_HDR     8
+#define DANDELION_TRACE_TEXT    (DANDELION_TRACE_SIZE - DANDELION_TRACE_HDR)
+
+/*
+ * Live framebuffer trace.
+ *
+ * The readback buffer above is useless on this board: the watchdog reset also
+ * drops DRAM, so nothing written there survives to the next boot.  While the
+ * bootstrap V=P mapping is still installed -- that is, until arm_vm_init()
+ * switches to the physmap -- the panel is reachable at its physical address,
+ * so mirror every checkpoint straight onto it and let the display controller
+ * scan it out.  start.s paints a red bar the same way; this paints text.
+ */
+#define DANDELION_FB_PA         0x7ec50000UL
+#define DANDELION_FB_STRIDE     2944
+#define DANDELION_FB_VISW       720
+#define DANDELION_FB_Y0         860
+#define DANDELION_FB_X0         8
+/*
+ * Bottom of the text area.  The panel is 1600 rows tall; the boot shim's
+ * stage bar sits at 1520, so spend everything above it.  When the cursor
+ * runs past this the line is dropped -- that is deliberate, but it means a
+ * silent stop here looks exactly like a crash, so keep it generous.
+ */
+#define DANDELION_FB_YMAX       1580
+#define DANDELION_FB_FG         0xffffff00U
+#define DANDELION_FB_BG         0xff000000U
+
+/*
+ * Bring-up probe bars.  Painted into the blank right-hand side of the
+ * panel (all trace text stays left of about x=300) so they never cover a
+ * checkpoint, and cleaned from the D-cache because the framebuffer is
+ * mapped as normal cacheable memory.
+ */
+#define DANDELION_PROBE_X       480
+#define DANDELION_PROBE_W       240
+
+static int dandelion_fb_live = 1;
+static unsigned int dandelion_fb_x = DANDELION_FB_X0;
+static unsigned int dandelion_fb_y = DANDELION_FB_Y0;
+
+static const unsigned char dandelion_font8x16[95][16] = {
+	{0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00},
+	{0x00,0x00,0x18,0x3c,0x3c,0x3c,0x18,0x18,0x18,0x00,0x18,0x18,0x00,0x00,0x00,0x00},
+	{0x00,0x66,0x66,0x66,0x24,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00},
+	{0x00,0x00,0x00,0x6c,0x6c,0xfe,0x6c,0x6c,0x6c,0xfe,0x6c,0x6c,0x00,0x00,0x00,0x00},
+	{0x18,0x18,0x7c,0xc6,0xc2,0xc0,0x7c,0x06,0x06,0x86,0xc6,0x7c,0x18,0x18,0x00,0x00},
