diff --git a/osfmk/kern/printf.c b/osfmk/kern/printf.c
index e44008f..bb4dfb3 100644
--- a/osfmk/kern/printf.c
+++ b/osfmk/kern/printf.c
@@ -908,6 +908,113 @@ vprintf(const char *fmt, va_list ap)
 	return vprintf_internal(fmt, ap, __builtin_return_address(0));
 }
 
+#if defined(DANDELION)
+/*
+ * Dandelion early boot trace.
+ *
+ * This board has no serial port, and the framebuffer text console does not
+ * exist until PE_create_console() runs in arm_init(), so a hang in the first
+ * few thousand instructions leaves no evidence at all.  Every character that
+ * reaches the console is therefore also appended to a fixed buffer inside the
+ * kernel's physical window; the boot shim reads that buffer back on the next
+ * boot (after the watchdog resets the phone) and prints it on the panel.
+ *
+ * The hook lives in _cnputc(), which every console write funnels through:
+ * kprintf() (via PE_kputc/console_write_unbuffered), printf() (via
+ * console_write), and the panic path (consdebug_putc*).  arm_init.c and
+ * startup.c additionally append plain checkpoints with dandelion_trace_mark()
+ * so progress is visible even where nothing prints.
+ *
+ * The buffer sits at the very top of the window, far above topOfKernelData
+ * and therefore not handed out by the VM during early boot.
+ *
+ * Until arm_vm_init() replaces the bootstrap translation tables the window is
+ * reachable through the identity map that start.s installs, so the physical
+ * address works as-is.  arm_vm_init() calls dandelion_trace_attach() right
+ * after the switch, which repoints the buffer at the physmap; the two lines
+ * in between are the only blind spot.
+ *
+ * The mappings are cacheable, so every character is cleaned to the point of
+ * coherency: the interesting part of the trace is whatever was written last,
+ * which is exactly what would still be sitting dirty in a cache when the
+ * watchdog fires.
+ */
+#define DANDELION_TRACE_PA      0x5ffc0000UL
+#define DANDELION_TRACE_SIZE    0x40000UL
+/* "XTX1": lets the shim tell a real trace from leftovers in RAM. */
+#define DANDELION_TRACE_MAGIC   0x58545831U
+#define DANDELION_TRACE_HDR     8
+#define DANDELION_TRACE_TEXT    (DANDELION_TRACE_SIZE - DANDELION_TRACE_HDR)
+
+extern unsigned long gPhysBase;
+extern unsigned long physmap_base;
+
+static volatile unsigned char *dandelion_trace_base =
+    (volatile unsigned char *)DANDELION_TRACE_PA;
+static volatile unsigned int dandelion_trace_len;
+
+void
+dandelion_trace_attach(void)
+{
+	if (physmap_base != 0) {
+		dandelion_trace_base = (volatile unsigned char *)
+		    (physmap_base + (DANDELION_TRACE_PA - gPhysBase));
+	}
+}
+
+void
+dandelion_trace_putc(char c)
+{
+	volatile unsigned char *base = dandelion_trace_base;
+	volatile unsigned int *hdr;
+	unsigned int off = dandelion_trace_len;
+
+	if (base == NULL) {
+		return;
+	}
+	hdr = (volatile unsigned int *)base;
+	if (hdr[0] != DANDELION_TRACE_MAGIC) {
+		hdr[0] = DANDELION_TRACE_MAGIC;
+		off = 0;
+	}
+	if (off >= (DANDELION_TRACE_TEXT - 2)) {
+		/*
+		 * Full.  Drop the oldest half instead of the newest: the text
+		 * that describes the hang is the text written last.
+		 */
+		unsigned int half = DANDELION_TRACE_TEXT / 2;
+		unsigned int i;
+
+		for (i = 0; i < half; i++) {
+			base[DANDELION_TRACE_HDR + i] =
+			    base[DANDELION_TRACE_HDR + i + half];
+		}
+		off -= half;
+
+		/* The shifted copy is dirty in the cache; push it all out. */
+		for (i = 0; i < DANDELION_TRACE_SIZE; i += 64) {
+			__asm__ volatile("dc cvac, %0" :: "r"((unsigned long)(base + i)) : "memory");
+		}
+		__asm__ volatile("dsb sy" ::: "memory");
+	}
+	base[DANDELION_TRACE_HDR + off] = (unsigned char)c;
+	base[DANDELION_TRACE_HDR + off + 1] = 0;
+	hdr[1] = off + 1;
+	dandelion_trace_len = off + 1;
+
+	__asm__ volatile("dc cvac, %0" :: "r"((unsigned long)(base + DANDELION_TRACE_HDR + off) & ~63UL) : "memory");
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
+void
+dandelion_trace_mark(const char *s)
+{
+	while (*s != '\0') {
+		dandelion_trace_putc(*s++);
+	}
+}
+#endif /* DANDELION */
