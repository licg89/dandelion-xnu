diff --git a/osfmk/vm/vm_map.c b/osfmk/vm/vm_map.c
index e5a6f9f..68702c7 100644
--- a/osfmk/vm/vm_map.c
+++ b/osfmk/vm/vm_map.c
@@ -7952,6 +7952,36 @@ __options_decl(vm_map_delete_state_t, uint32_t, {
 	VMDS_KERNEL_KMEMPTR     = 0x0020
 });
 
+#if defined(DANDELION)
+/*
+ * Bring-up diagnosis.  A deletion from a kernel-pmap map that finds a gap
+ * panics with nothing but the range, which says what went wrong but not
+ * whose address space arithmetic produced it.  Report every such deletion
+ * with its caller so the panic can be attributed.
+ */
+extern void dandelion_trace_mark(const char *);
+
+__attribute__((noinline))
+static void
+dandelion_vm_map_delete_trace(
+	vm_map_t                map,
+	vm_map_offset_t         start,
+	vm_map_offset_t         end,
+	void                   *ra)
+{
+	char buf[192];
+
+	snprintf(buf, sizeof(buf),
+	    "[dl] del ra=0x%lx map=0x%lx pm=0x%lx min=0x%llx max=0x%llx "
+	    "s=0x%llx e=0x%llx\n",
+	    (unsigned long)(uintptr_t)ra, (unsigned long)(uintptr_t)map,
+	    (unsigned long)(uintptr_t)vm_map_pmap(map),
+	    (uint64_t)vm_map_min(map), (uint64_t)vm_map_max(map),
+	    (uint64_t)start, (uint64_t)end);
+	dandelion_trace_mark(buf);
+}
+#endif /* DANDELION */
+
