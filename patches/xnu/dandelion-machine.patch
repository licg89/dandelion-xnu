diff --git a/makedefs/MakeInc.def b/makedefs/MakeInc.def
index 5bd6f23..1a829f3 100644
--- a/makedefs/MakeInc.def
+++ b/makedefs/MakeInc.def
@@ -29,7 +29,7 @@ SUPPORTED_ARM64_MACHINE_CONFIGS = NONE
 else ifneq ($(findstring _host,$(RC_ProjectName)),)
 SUPPORTED_ARM64_MACHINE_CONFIGS = NONE
 else
-SUPPORTED_ARM64_MACHINE_CONFIGS = BCM2837 T6000 T8101 T8103 VMAPPLE
+SUPPORTED_ARM64_MACHINE_CONFIGS = BCM2837 DANDELION T6000 T8101 T8103 VMAPPLE
 
 endif
 
@@ -61,6 +61,8 @@ MACHINE_FLAGS_ARM64_T8103 = -DARM64_BOARD_CONFIG_T8103                  -mcpu=ap
 MACHINE_FLAGS_ARM64_T6000 = -DARM64_BOARD_CONFIG_T6000 		-mcpu=apple-a14
 MACHINE_FLAGS_ARM64_VMAPPLE = -DARM64_BOARD_CONFIG_VMAPPLE              -march=armv8.5a
 MACHINE_FLAGS_ARM64_BCM2837 = -DARM64_BOARD_CONFIG_BCM2837
+# MediaTek MT6762G (Cortex-A53), no Apple-specific instruction set features.
+MACHINE_FLAGS_ARM64_DANDELION = -DARM64_BOARD_CONFIG_DANDELION
 
 
 #
diff --git a/osfmk/arm64/proc_reg.h b/osfmk/arm64/proc_reg.h
index 133b07f..0845a7e 100644
--- a/osfmk/arm64/proc_reg.h
+++ b/osfmk/arm64/proc_reg.h
@@ -213,6 +213,14 @@
 /* D-Cache. */
 #define MMU_CLINE   6
 
+#elif defined (DANDELION) /* MediaTek MT6762G, Cortex-A53 */
+
+/* I-Cache. The Cortex-A53 L1I line is 64 bytes. */
+#define MMU_I_CLINE 6
+
+/* D-Cache. The Cortex-A53 L1D line is 64 bytes. */
+#define MMU_CLINE   6
+
 #elif defined (VMAPPLE)
 
 /* I-Cache. */
diff --git a/pexpert/pexpert/arm64/Makefile b/pexpert/pexpert/arm64/Makefile
index 8226b8c..48c048b 100644
--- a/pexpert/pexpert/arm64/Makefile
+++ b/pexpert/pexpert/arm64/Makefile
@@ -17,7 +17,8 @@ PRIVATE_KERNELFILES = \
 	boot.h \
 	H13.h \
 	VMAPPLE.h \
-	BCM2837.h
+	BCM2837.h \
+	DANDELION.h
 
 
 # Headers installed into System.framework/PrivateHeaders (userspace internal SDK only).
diff --git a/pexpert/pexpert/arm64/board_config.h b/pexpert/pexpert/arm64/board_config.h
index 9454534..2fecbc9 100644
--- a/pexpert/pexpert/arm64/board_config.h
+++ b/pexpert/pexpert/arm64/board_config.h
@@ -97,6 +97,18 @@
 #define CORE_NCTRS                     8 /* Placeholder; KPC is not enabled for this target */
 #endif  /* ARM64_BOARD_CONFIG_BCM2837 */
 
+#ifdef ARM64_BOARD_CONFIG_DANDELION
+#include <pexpert/arm64/DANDELION.h>
+
+#define MAX_L2_CLINE                   6
+#define MAX_CPUS                       8
+/* Software topology only for now: the port runs on one core (cpus=1) and
