+#if defined(DANDELION)
+/*
+ * exec-path ring markers (bring-up).
+ *
+ * The 2026-10-31 12:1x boot stopped between "attempting to load" and any outcome
+ * line.  These bracket every step in between so one boot names the function that
+ * hangs.  dandelion_trace_mark() writes into the in-memory ring the eMMC log
+ * channel drains; nothing here may use the console.
+ */
+extern void dandelion_trace_mark(const char *);
+extern int snprintf(char *, size_t, const char *, ...);
+
+static void
+dl_exec_mark(const char *what, long value)
+{
+	char _buf[96];
+
+	snprintf(_buf, sizeof(_buf), "[dl] exec %s=%ld\n", what, value);
+	dandelion_trace_mark(_buf);
+}
+#define DL_EXEC_MARK(what, value)  dl_exec_mark((what), (long)(value))
+#else
+#define DL_EXEC_MARK(what, value)  do { } while (0)
+#endif
+
