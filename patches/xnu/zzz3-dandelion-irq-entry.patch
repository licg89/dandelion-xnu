diff --git a/osfmk/arm64/sleh.c b/osfmk/arm64/sleh.c
index 9e64376..125b60c 100644
--- a/osfmk/arm64/sleh.c
+++ b/osfmk/arm64/sleh.c
@@ -1871,46 +1871,69 @@ sleh_irq(arm_saved_state_t *state)
 		uint32_t intid = dandelion_gic_ack();
 
 		/*
-		 * First-interrupt decider (see docs/research/irq-entry-audit.md).
-		 * Log the pending INTID and the timer state once, and mask both
-		 * architectural timers so a level-triggered PPI cannot livelock
-		 * the run before the log is flushed.
+		 * Interrupt-context reporting, ring only.
+		 *
+		 * printf() may not be used here: this runs with DAIF.I set and
+		 * serial_console.c:168 panics with "Console I/O from
+		 * interrupt-disabled context".  dandelion_trace_mark() writes into the
+		 * in-memory trace ring, which the eMMC log channel dumps later, so the
+		 * report survives without touching the console.
+		 *
+		 * The first interrupt is also answered with the minimum the
+		 * architecture requires and nothing else -- mask the timer if that is
+		 * what fired, EOI, return, no rtclock_intr() -- so that one boot
+		 * separates "the entry/EOI path works" from "rtclock_intr() is the
+		 * problem".
+		 */
+		{
+			static unsigned int dl_irq_count;
+
+			dl_irq_count++;
+			if (dl_irq_count <= 6u || (dl_irq_count % 100u) == 0u) {
+				char _buf[96];
+				extern void dandelion_trace_mark(const char *);
+
+				snprintf(_buf, sizeof(_buf),
+				    "[dl] irq %u intid=%u hppir1=%llx\n", dl_irq_count,
+				    (unsigned)intid,
+				    (unsigned long long)__builtin_arm_rsr64("ICC_HPPIR1_EL1"));
+				dandelion_trace_mark(_buf);
+			}
+			/*
+			 * Nothing is skipped any more: the previous boot proved that
+			 * acknowledging and EOI-ing this interrupt leaves the machine
+			 * alive, so the next thing to measure is rtclock_intr() itself,
+			 * which now reports its own steps through the ring
+			 * (osfmk/arm/rtclock.c, DL_RTC_MARK).
+			 */
+		}
+
+		/*
+		 * Kept for continuity with earlier logs: one ring marker the first
+		 * time an interrupt is entered at all.  Everything else that used to be
+		 * here moved into the block above, where it does no console I/O.
 		 */
 		{
 			static int decider_done;
 
 			if (!decider_done) {
-				uint64_t hppir1 = __builtin_arm_rsr64("ICC_HPPIR1_EL1");
-				uint64_t cntv_ctl = __builtin_arm_rsr64("CNTV_CTL_EL0");
-				uint64_t cntv_tval = __builtin_arm_rsr64("CNTV_TVAL_EL0");
-				uint64_t cntp_ctl = __builtin_arm_rsr64("CNTP_CTL_EL0");
+				extern void dandelion_trace_mark(const char *);
 
 				decider_done = 1;
-				{
-					extern void dandelion_trace_mark(const char *);
-					dandelion_trace_mark("[irq1] first irq seen\n");
-				}
-				/*
-				 * The timers are deliberately left alone: the shim now
-				 * disables INTID 30 before the handoff, so the level
-				 * storm that forced the mask is gone, and masking CNTV
-				 * would also kill the only tick the scheduler has.
-				 */
-
-				kprintf("DANDELION irq1: hppir1=%llu intid=%u cntv_ctl=%llu "
-				    "cntv_tval=%llu cntp_ctl=%llu\n",
-				    hppir1, (unsigned)intid, cntv_ctl, cntv_tval, cntp_ctl);
+				dandelion_trace_mark("[irq1] first irq seen\n");
 			}
 		}
 
-		if (intid == DANDELION_TIMER_IRQ) {
-			cdp->cpu_decrementer = -1; /* Large */
-			rtclock_intr(TRUE);
-		} else if (intid < GIC_SPURIOUS_IRQ && cdp->interrupt_handler) {
-			cdp->interrupt_handler(cdp->interrupt_target,
-			    cdp->interrupt_refCon,
-			    cdp->interrupt_nub,
-			    cdp->interrupt_source);
+		{
+			if (intid == DANDELION_TIMER_IRQ) {
+				cdp->cpu_decrementer = -1; /* Large */
+				rtclock_intr(TRUE);
+			} else if (intid < GIC_SPURIOUS_IRQ && cdp->interrupt_handler) {
+				cdp->interrupt_handler(cdp->interrupt_target,
+				    cdp->interrupt_refCon,
+				    cdp->interrupt_nub,
+				    cdp->interrupt_source);
+			}
 		}
 		dandelion_gic_eoi(intid);
 	}
