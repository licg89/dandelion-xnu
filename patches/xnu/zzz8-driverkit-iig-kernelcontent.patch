diff --git a/iokit/DriverKit/IORPC.h b/iokit/DriverKit/IORPC.h
index 3ded78c..f1b1f96 100644
--- a/iokit/DriverKit/IORPC.h
+++ b/iokit/DriverKit/IORPC.h
@@ -224,6 +224,22 @@ struct IORPC {
 	IORPCMessageMach * reply;
 	uint32_t           sendSize;
 	uint32_t           replySize;
+	/*
+	 * The in-kernel IORPCMessage this IORPC carries -- the same value
+	 * IORPCMessageFromMach(message, false) returns.  The DriverKit glue that
+	 * iig generates now names it:
+	 *
+	 *	IORPCMessage * msg = rpc.kernelContent;
+	 *	IORPC rpc = { ..., .kernelContent = &buf.msg.content.__hdr };
+	 *
+	 * iig is xcrun's, from the SDK, so its idea of IORPC is the SDK's and is
+	 * newer than this file; this header wins at compile time because it is
+	 * exported into the kernel's include path, which is how the generated
+	 * code ends up referring to a member that does not exist.  Keep the
+	 * member last: the initializer above is a designated initializer, and C++
+	 * requires those to be in declaration order.
+	 */
+	IORPCMessage     * kernelContent;
 };
 typedef struct IORPC IORPC;
 
