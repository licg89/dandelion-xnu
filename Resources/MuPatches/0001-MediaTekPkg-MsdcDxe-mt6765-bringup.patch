# Patch for the upstream tree in D:\aios\uefi-a04br3 (mouseos/uefi-a04br3).
# Apply with: git -C <uefi-tree> apply -p1 <this file>
#
# Two changes to MediaTekPkg/Drivers/MsdcDxe/MsdcDxe.c:
#
# 1. Drop the two dead MSDC_PRIVATE_DATA *Private assignments in the PassThru
#    callbacks.  CLANGPDB builds with -Werror and that is a hard error
#    (-Wunused-but-set-variable).
#
# 2. MT6765 bring-up values, from the vendor kernel and LK:
#      MSDC_PATCH_BIT0 = 0x403C0007   (was MT6768's 0x403c0446)
#      MSDC_PATCH_BIT1 = 0xFFFA0349   (was MT6768's 0xffff4089)
#      clear EMMC_CFG0.BOOTSUPP, which LK clears because leaving it set "may
#      cause eMMC initialization to fail after BROM operations" -- and we are
#      started by LK right after it used the card.
#    Sources: vendor mt6765/msdc_cust.h:281-282, LK msdc_io.h:315-316,
#    LK msdc.c:2932-2938.
diff --git a/Silicon/MediaTek/MediaTekPkg/Drivers/MsdcDxe/MsdcDxe.c b/Silicon/MediaTek/MediaTekPkg/Drivers/MsdcDxe/MsdcDxe.c
index 5d4799d..07980cb 100644
--- a/Silicon/MediaTek/MediaTekPkg/Drivers/MsdcDxe/MsdcDxe.c
+++ b/Silicon/MediaTek/MediaTekPkg/Drivers/MsdcDxe/MsdcDxe.c
@@ -105,14 +105,14 @@ MsdcGetNextSlot (
   EFI_SD_MMC_PASS_THRU_PROTOCOL *This,
   UINT8 *Slot)
 {
-  MSDC_PRIVATE_DATA *Private;
-
+  // NOTE(dandelion): the inherited upstream body assigned Private here and
+  // never read it, which is a -Werror,-Wunused-but-set-variable failure with
+  // CLANGPDB. The assignment was dead code (the function only looks at *Slot),
+  // so the variable is dropped rather than silenced with (VOID).
   if (This == NULL || Slot == NULL) {
     return EFI_INVALID_PARAMETER;
   }
 
-  Private = MSDC_PRIVATE_FROM_THIS (This);
-
   if (*Slot == 0xFF) {
     *Slot = 0;
     return EFI_SUCCESS;
@@ -164,14 +164,11 @@ MsdcGetSlotNumber (
   EFI_DEVICE_PATH_PROTOCOL *DevicePath,
   UINT8 *Slot)
 {
-  MSDC_PRIVATE_DATA *Private;
-
+  // NOTE(dandelion): same dead assignment as MsdcGetNextSlot (see above).
   if ((This == NULL) || (DevicePath == NULL) || (Slot == NULL)) {
     return EFI_INVALID_PARAMETER;
   }
 
-  Private = MSDC_PRIVATE_FROM_THIS (This);
-
   if ((DevicePath->Type != MESSAGING_DEVICE_PATH) ||
       ((DevicePath->SubType != MSG_SD_DP) &&
        (DevicePath->SubType != MSG_EMMC_DP)) ||
@@ -765,8 +762,23 @@ VOID MsdcInit (
   MsdcWrite (Private, MSDC_IOCON, 0);
 
   // Quirks
-  MsdcWrite (Private, MSDC_PATCH_BIT0, 0x403c0446);
-  MsdcWrite (Private, MSDC_PATCH_BIT1, 0xffff4089);
+  //
+  // [VERIFIED] These were MT6768 values.  MT6765 uses
+  //   MSDC_PATCH_BIT0 = 0x403C0007   (vendor mt6765/msdc_cust.h:281, LK msdc_io.h:315)
+  //   MSDC_PATCH_BIT1 = 0xFFFA0349   (vendor mt6765/msdc_cust.h:282, LK msdc_io.h:316)
+  // The MT6768 constants differ in PB0 bits 6/8/9, i.e. they configure MT6768
+  // sampling/CMD behaviour on an MT6765 controller.
+  //
+  MsdcWrite (Private, MSDC_PATCH_BIT0, 0x403C0007);
+  MsdcWrite (Private, MSDC_PATCH_BIT1, 0xFFFA0349);
+
+  //
+  // [VERIFIED] LK clears EMMC_CFG0.BOOTSUPP before card identification and
+  // comments that leaving it set "may cause eMMC initialization to fail after
+  // BROM operations" (LK msdc.c:2932-2938).  We are handed over by LK right
+  // after it used the card, i.e. exactly the situation that comment describes.
+  //
+  MsdcClrBits (Private, EMMC_CFG0, BIT15);
 
   MsdcSetBits (Private, EMMC50_CFG0, EMMC50_CFG0_CRCSTSSEL);
 
