+                       (((UINT32)(NullGpdAddress >> 32) & DDN_DESC_HIGH_MASK) << DDN_GPD_NEXT_HIGH_SHIFT) |
+                       (((UINT32)(BdAddress >> 32) & DDN_DESC_HIGH_MASK) << DDN_GPD_BD_HIGH_SHIFT);
