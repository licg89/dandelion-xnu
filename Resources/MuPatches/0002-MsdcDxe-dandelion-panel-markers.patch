+  UINTN       Address;
+  UINTN       GpdAddress;
+  UINTN       BdAddress;
+  UINTN       NullGpdAddress;
+  UINT32      DmaControl;
+  UINT32      IntStatus;
+  UINT32      Spins;
+  UINT8       Checksum;
