# Patch for the upstream tree in D:\aios\uefi-a04br3 (mouseos/uefi-a04br3).
# Apply with: git -C D:\aios\uefi-a04br3 apply Resources/MuPatches/0001-MediaTekPkg-MsdcDxe-drop-dead-Private.patch
# Why: CLANGPDB builds with -Werror; the two PassThru callbacks assign
# MSDC_PRIVATE_DATA *Private and never read it, which is a hard error.
# The assignments were dead code, so they are dropped rather than silenced.

diff --git a/Silicon/MediaTek/MediaTekPkg/Drivers/MsdcDxe/MsdcDxe.c b/Silicon/MediaTek/MediaTekPkg/Drivers/MsdcDxe/MsdcDxe.c
index 5d4799d..f88ec53 100644
--- a/Silicon/MediaTek/MediaTekPkg/Drivers/MsdcDxe/MsdcDxe.c
+++ b/Silicon/MediaTek/MediaTekPkg/Drivers/MsdcDxe/MsdcDxe.c
@@ -105,14 +105,14 @@ MsdcGetNextSlot (
   EFI_SD_MMC_PASS_THRU_PROTOCOL *This,
   UINT8 *Slot)
 {
-  MSDC_PRIVATE_DATA *Private;
-
+  // NOTE(dandelion): the inherited upstream body assigned Private here and
+  // never read it, which is a -Werror,-Wunused-but-set-variable failure with
+  // CLANGPDB. The assignment was dead code (the function only looks at *Slot),
+  // so the variable is dropped rather than silenced with (VOID).
   if (This == NULL || Slot == NULL) {
     return EFI_INVALID_PARAMETER;
   }
 
-  Private = MSDC_PRIVATE_FROM_THIS (This);
-
   if (*Slot == 0xFF) {
     *Slot = 0;
     return EFI_SUCCESS;
@@ -164,14 +164,11 @@ MsdcGetSlotNumber (
   EFI_DEVICE_PATH_PROTOCOL *DevicePath,
   UINT8 *Slot)
 {
-  MSDC_PRIVATE_DATA *Private;
-
+  // NOTE(dandelion): same dead assignment as MsdcGetNextSlot (see above).
   if ((This == NULL) || (DevicePath == NULL) || (Slot == NULL)) {
     return EFI_INVALID_PARAMETER;
   }
 
-  Private = MSDC_PRIVATE_FROM_THIS (This);
-
   if ((DevicePath->Type != MESSAGING_DEVICE_PATH) ||
       ((DevicePath->SubType != MSG_SD_DP) &&
        (DevicePath->SubType != MSG_EMMC_DP)) ||
