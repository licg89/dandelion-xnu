# Dandelion (Redmi 9A / MT6762G) Kernel Configuration
# Based on mouseos MASTER.arm64.a04br3, adapted for MT6762G
#
# NOTE: this file is a placeholder.  XNU's SETUP/config only understands
# Apple's MASTER syntax (machine / makeoptions / options / files); the keys
# below document the target rather than forming a buildable configuration.
# See docs/XNU_INTEGRATION.md section 4 for how to derive the real file.

# Architecture
ARCH_CONFIGS = ARM64
MACHINE_CONFIGS = DANDELION

# CPU
CPU_TYPE = CORTEX_A53
NCPUS = 8
SMP = 1
PSCI = 1

# Memory
# Cortex-A53 has no 16K granule (ID_AA64MMFR0_EL1.TGran16 == 0), so this is a
# 4 KiB page kernel.  See docs/MMU_GRANULE.md.
PAGE_SIZE = 4096
T1SZ = 25
PHYS_BASE = 0x40000000
MEM_SIZE = 0x100000000

# Interrupt Controller
GIC_VERSION = 3
GIC_BASE = 0x0C000000

# Timer
TIMER_FREQ = 13000000

# Early Console
EARLY_CONSOLE = 1
UART_BASE = 0x11002000
UART_BAUD = 921600

# Disable Apple-specific features
APPLE_PAC = 0
APPLE_PAN = 0
APPLE_LSE = 0
APPLE_PERFMON = 0
KPC = 0

# Enable open-source ARM assembly
OPEN_ARM_ASM = 1

# Debug
DEBUG = 1
DEVELOPMENT = 1
VERBOSE = 1
