##
#  M4 storage beacon: dispatched only when a SimpleFileSystem exists, so the
#  line it prints is proof that eMMC -> BlockIo -> partition -> FAT works.
#
#  Copyright (c) Microsoft Corporation.
#  SPDX-License-Identifier: BSD-2-Clause-Patent
##
[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = StorageBeaconDxe
  FILE_GUID                      = 3C7A9E10-5B24-4D86-8F01-6E2B4C9D7A38
  MODULE_TYPE                    = DXE_DRIVER
  VERSION_STRING                 = 1.0
  ENTRY_POINT                    = StorageBeaconDxeEntryPoint

[Sources]
  StorageBeaconDxe.c

[Packages]
  MdePkg/MdePkg.dec

[LibraryClasses]
  UefiBootServicesTableLib
  UefiDriverEntryPoint

[Protocols]
  gEfiBlockIoProtocolGuid            ## CONSUMES
  gEfiSimpleFileSystemProtocolGuid   ## CONSUMES

#
# Depend on BlockIo, not on SimpleFileSystem (2026-10-28 21:4x): with the
# filesystem dependency this driver only ever appeared if FAT had bound a
# volume, which told us "M4 works" but not WHERE it stopped when it didn't.
# BlockIo is the first thing the eMMC stack produces, so:
#
#   nothing on screen   -> MsdcDxe/EmmcDxe never produced a block device
#   "BLOCK OK" only     -> block device exists, partition/FAT is the problem
#   "BLOCK OK" + "FAT n"-> M4 done
#
[Depex]
  gEfiBlockIoProtocolGuid
