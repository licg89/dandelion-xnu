##
#  M4 storage beacon: dispatched as soon as MsdcDxe publishes the SD/MMC
#  pass-through protocol, then does the ConnectController sweep itself and
#  reports on the panel how far eMMC -> BlockIo -> partition -> FAT got.
#
#  Copyright (c) Microsoft Corporation.
#  SPDX-License-Identifier: BSD-2-Clause-Patent
##
[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = StorageBeaconDxe
  FILE_GUID                      = 3C7A9E10-5B24-4D86-8F01-6E2B4C9D7A38
  MODULE_TYPE                    = DXE_DRIVER
  VERSION_STRING                 = 1.0
  ENTRY_POINT                    = StorageBeaconDxeEntryPoint

[Sources]
  StorageBeaconDxe.c

[Packages]
  MdePkg/MdePkg.dec

[LibraryClasses]
  UefiBootServicesTableLib
  UefiDriverEntryPoint

[Protocols]
  gEfiBlockIoProtocolGuid            ## CONSUMES
  gEfiSimpleFileSystemProtocolGuid   ## CONSUMES
  gEfiSdMmcPassThruProtocolGuid      ## CONSUMES

#
# Depend on the pass-through protocol (2026-10-29 00:3x).
#
# Two earlier choices were both wrong for different reasons:
#
#   SimpleFileSystem -> only ran once FAT had already bound a volume, i.e. it
#                       could report success but never say where it stopped;
#   BlockIo          -> ran only after EmmcDxe had bound, which is precisely the
#                       binding that never happens on this platform: nothing
#                       calls ConnectController for the pass-through handle
#                       (BDS would, and BDS does not get that far here).
#
# Depending on SdMmcPassThru means this driver is dispatched the instant
# MsdcDxe installs it -- early enough to run the connect sweep itself and
# produce the BlockIo handle rather than wait for one.
#
# Cell map on the panel (y 1400, 80x80, pitch 88):
#
#   6 yellow  this driver ran -> the pass-through protocol exists
#   4 purple  a BlockIo handle exists
#   7 red     connect sweep finished with no block device
#   5 green   a SimpleFileSystem mounted
#
[Depex]
  gEfiSdMmcPassThruProtocolGuid
